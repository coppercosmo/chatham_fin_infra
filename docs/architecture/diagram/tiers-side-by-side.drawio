<mxfile host="tiers-side-by-side" type="device"><diagram id="tiers-side-by-side" name="Three isolation tiers side by side"><mxGraphModel dx="8580" dy="3088" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="8580" pageHeight="3088" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Three isolation tiers, side by side (ADR 0014)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=72;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="60" y="37" width="1861" height="78" as="geometry"/></mxCell><mxCell id="c3" value="Read left to right: each tier shares more of the expensive, stateless parts (front door, AI gateway, compute, search units) and keeps the cheap parts that hold data per client. Azure OpenAI tokens cost the same in every tier." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=34;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="60" y="137" width="4290" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8a94a3;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4290" y="248" as="sourcePoint"/><mxPoint x="70" y="248" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8a94a3;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4290" y="248" as="sourcePoint"/><mxPoint x="8510" y="248" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="More isolated, more expensive" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=30;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="120" y="203" width="493" height="36" as="geometry"/></mxCell><mxCell id="c7" value="More shared, cheaper" style="text;html=1;align=right;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=30;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="8118" y="203" width="342" height="36" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#7a8594;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="3300" height="300" as="geometry"/></mxCell><mxCell id="c9" value="Tier 1: Dedicated (default)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=60;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="100" y="311" width="913" height="66" as="geometry"/></mxCell><mxCell id="c10" value="A private copy of everything, in the client&#x27;s own subscription" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=36;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="100" y="393" width="1256" height="42" as="geometry"/></mxCell><mxCell id="c11" value="~USD 1,500 per client a month  ·  up to highly confidential data  ·  blast radius: 1 client" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=32;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="100" y="457" width="1637" height="38" as="geometry"/></mxCell><mxCell id="c12" value="Boundary: the client&#x27;s own subscription. Shared: only P&amp;T&#x27;s hub. Terraform: stamps/client" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=32;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="100" y="507" width="1601" height="38" as="geometry"/></mxCell><mxCell id="t1" value="Tier 1: Dedicated (default)" parent="0"/><mxCell id="t1-c2" value="Chatham AI Advisory hosting platform on Azure: multi-client solution architecture" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=28;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="90.0" y="647.0" width="1276" height="34" as="geometry" /></mxCell><mxCell id="t1-c3" value="One subscription per client (ADR 0001), built from the same Terraform stamp, inside Platform Engineering's landing zone. Every client resource below is private; nothing is shared between clients." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=15;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="90.0" y="686.0" width="1644" height="21" as="geometry" /></mxCell><mxCell id="t1-c4" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=2;" vertex="1" parent="t1"><mxGeometry x="90.0" y="725.0" width="3240" height="235" as="geometry" /></mxCell><mxCell id="t1-c5" value="Entra ID tenant and governance  (owned by Platform Engineering / P&amp;T)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#3b74c4;" vertex="1" parent="t1"><mxGeometry x="104.0" y="733.0" width="663" height="23" as="geometry" /></mxCell><mxCell id="t1-c6" value="ADR 0002: AI Advisory is a landing-zone consumer. P&amp;T owns hierarchy, policy, identity and connectivity; we build inside their guardrails." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="104.0" y="757.0" width="933" height="18" as="geometry" /></mxCell><mxCell id="t1-c7" value="&lt;b style=&quot;font-size:13px&quot;&gt;Tenant root MG&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="110.0" y="813.0" width="150" height="40" as="geometry" /></mxCell><mxCell id="t1-c8" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/general/Management_Groups.svg;" vertex="1" parent="t1"><mxGeometry x="236.0" y="818.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c9" value="&lt;b style=&quot;font-size:13px&quot;&gt;Chatham MG&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;P&amp;amp;T policy initiatives&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="280.0" y="813.0" width="190" height="50" as="geometry" /></mxCell><mxCell id="t1-c10" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/general/Management_Groups.svg;" vertex="1" parent="t1"><mxGeometry x="446.0" y="818.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c11" value="&lt;b style=&quot;font-size:13px&quot;&gt;Platform MG&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5b6675&quot;&gt;hub, identity, mgmt subs&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="490.0" y="791.0" width="170" height="49" as="geometry" /></mxCell><mxCell id="t1-c12" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/general/Management_Groups.svg;" vertex="1" parent="t1"><mxGeometry x="636.0" y="796.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c13" value="&lt;b style=&quot;font-size:13px&quot;&gt;Landing zones / Corp MG&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="490.0" y="839.0" width="170" height="52" as="geometry" /></mxCell><mxCell id="t1-c14" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/general/Management_Groups.svg;" vertex="1" parent="t1"><mxGeometry x="636.0" y="844.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c15" value="&lt;b style=&quot;font-size:13px&quot;&gt;AI Advisory MG&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;AI guardrails (policy/ proposals)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="680.0" y="839.0" width="210" height="50" as="geometry" /></mxCell><mxCell id="t1-c16" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/general/Management_Groups.svg;" vertex="1" parent="t1"><mxGeometry x="866.0" y="844.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c17" value="&lt;b style=&quot;font-size:13px&quot;&gt;sub: AI Advisory Platform&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e7f6f1;strokeColor=#1f8a68;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="910.0" y="809.0" width="200" height="36" as="geometry" /></mxCell><mxCell id="t1-c18" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="t1"><mxGeometry x="1086.0" y="814.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c19" value="&lt;b style=&quot;font-size:13px&quot;&gt;AI Advisory / Clients MG&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="910.0" y="857.0" width="200" height="36" as="geometry" /></mxCell><mxCell id="t1-c20" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/general/Management_Groups.svg;" vertex="1" parent="t1"><mxGeometry x="1086.0" y="862.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c21" value="&lt;b style=&quot;font-size:13px&quot;&gt;sub: chatham (ring 0)&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="1130.0" y="791.0" width="200" height="35" as="geometry" /></mxCell><mxCell id="t1-c22" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="t1"><mxGeometry x="1306.0" y="796.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c23" value="&lt;b style=&quot;font-size:13px&quot;&gt;sub: acme (ring 1)&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="1130.0" y="831.0" width="200" height="35" as="geometry" /></mxCell><mxCell id="t1-c24" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="t1"><mxGeometry x="1306.0" y="836.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c25" value="&lt;b style=&quot;font-size:13px&quot;&gt;sub: meridian (ring 2)&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="1130.0" y="871.0" width="200" height="35" as="geometry" /></mxCell><mxCell id="t1-c26" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="t1"><mxGeometry x="1306.0" y="876.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c27" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8a94a3;strokeWidth=1.2;endArrow=block;endFill=1;" edge="1" parent="t1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="833.0" as="sourcePoint" /><mxPoint x="280.0" y="833.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t1-c28" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8a94a3;strokeWidth=1.2;endArrow=block;endFill=1;" edge="1" parent="t1"><mxGeometry relative="1" as="geometry"><mxPoint x="470.0" y="833.0" as="sourcePoint" /><mxPoint x="490.0" y="809.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t1-c29" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8a94a3;strokeWidth=1.2;endArrow=block;endFill=1;" edge="1" parent="t1"><mxGeometry relative="1" as="geometry"><mxPoint x="470.0" y="833.0" as="sourcePoint" /><mxPoint x="490.0" y="857.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t1-c30" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8a94a3;strokeWidth=1.2;endArrow=block;endFill=1;" edge="1" parent="t1"><mxGeometry relative="1" as="geometry"><mxPoint x="660.0" y="857.0" as="sourcePoint" /><mxPoint x="680.0" y="859.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t1-c31" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8a94a3;strokeWidth=1.2;endArrow=block;endFill=1;" edge="1" parent="t1"><mxGeometry relative="1" as="geometry"><mxPoint x="890.0" y="859.0" as="sourcePoint" /><mxPoint x="910.0" y="827.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t1-c32" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8a94a3;strokeWidth=1.2;endArrow=block;endFill=1;" edge="1" parent="t1"><mxGeometry relative="1" as="geometry"><mxPoint x="890.0" y="859.0" as="sourcePoint" /><mxPoint x="910.0" y="875.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t1-c33" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8a94a3;strokeWidth=1.2;endArrow=block;endFill=1;" edge="1" parent="t1"><mxGeometry relative="1" as="geometry"><mxPoint x="1110.0" y="875.0" as="sourcePoint" /><mxPoint x="1130.0" y="808.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t1-c34" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8a94a3;strokeWidth=1.2;endArrow=block;endFill=1;" edge="1" parent="t1"><mxGeometry relative="1" as="geometry"><mxPoint x="1110.0" y="875.0" as="sourcePoint" /><mxPoint x="1130.0" y="848.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t1-c35" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8a94a3;strokeWidth=1.2;endArrow=block;endFill=1;" edge="1" parent="t1"><mxGeometry relative="1" as="geometry"><mxPoint x="1110.0" y="875.0" as="sourcePoint" /><mxPoint x="1130.0" y="888.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t1-c36" value="Subscription vending: P&amp;T template per client (MG placement, IPAM /22, Entra groups, budget owner, AOAI quota request)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="110.0" y="920.0" width="799" height="18" as="geometry" /></mxCell><mxCell id="t1-c37" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure Policy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;deny public endpoints, allowed regions,&lt;br&gt;tags, DINE private DNS, diagnostics&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="1380.0" y="787.0" width="375" height="65" as="geometry" /></mxCell><mxCell id="t1-c38" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/management_governance/Policy.svg;" vertex="1" parent="t1"><mxGeometry x="1731.0" y="792.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c39" value="&lt;b style=&quot;font-size:13px&quot;&gt;Entra ID groups + PIM&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;sg-aiadv-&amp;lt;client&amp;gt;-readers / -operators&lt;br&gt;-aks-admins (PIM eligible)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="1770.0" y="787.0" width="375" height="65" as="geometry" /></mxCell><mxCell id="t1-c40" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/identity/Groups.svg;" vertex="1" parent="t1"><mxGeometry x="2121.0" y="792.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c41" value="&lt;b style=&quot;font-size:13px&quot;&gt;Defender for Cloud / Sentinel&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;CSPM + workload protection&lt;br&gt;(incl. Defender for Containers)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="2160.0" y="787.0" width="375" height="65" as="geometry" /></mxCell><mxCell id="t1-c42" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/security/Azure_Defender.svg;" vertex="1" parent="t1"><mxGeometry x="2511.0" y="792.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c43" value="&lt;b style=&quot;font-size:13px&quot;&gt;IPAM + DDoS Network Protection&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;spoke CIDRs, DDoS plan on&lt;br&gt;public IPs (policy)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="2550.0" y="787.0" width="375" height="65" as="geometry" /></mxCell><mxCell id="t1-c44" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/DDoS_Protection_Plans.svg;" vertex="1" parent="t1"><mxGeometry x="2901.0" y="792.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c45" value="&lt;b style=&quot;font-size:13px&quot;&gt;Policy as code in CI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;Checkov mirrors P&amp;amp;T rules;&lt;br&gt;policy/ = AI guardrail proposals&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="2940.0" y="787.0" width="375" height="65" as="geometry" /></mxCell><mxCell id="t1-c46" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/management_governance/Policy.svg;" vertex="1" parent="t1"><mxGeometry x="3291.0" y="792.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c47" value="Azure Policy add-on (Gatekeeper) enforces the same initiatives inside every AKS cluster. Exemptions are time-boxed and recorded in an ADR." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="1380.0" y="862.0" width="933" height="18" as="geometry" /></mxCell><mxCell id="t1-s46" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#f3f1f8;strokeColor=#6b5ca5;strokeWidth=2;" vertex="1" parent="t1"><mxGeometry x="90.0" y="1010.0" width="360" height="1468" as="geometry" /></mxCell><mxCell id="t1-c49" value="Users and edge" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#6b5ca5;" vertex="1" parent="t1"><mxGeometry x="104.0" y="1018.0" width="139" height="23" as="geometry" /></mxCell><mxCell id="t1-c50" value="&lt;b style=&quot;font-size:13px&quot;&gt;acme analysts (insurance): ExpressRoute&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;acme&amp;#x27;s own circuit -&amp;gt; hub ExpressRoute gateway&lt;br&gt;-&amp;gt; firewall: acme ranges to acme AGW:443 only&lt;br&gt;acme.ai.&amp;lt;domain&amp;gt;, private only (ADR 0013)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="105.0" y="1070.0" width="330" height="80" as="geometry" /></mxCell><mxCell id="t1-c51" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Virtual_Network_Gateways.svg;" vertex="1" parent="t1"><mxGeometry x="411.0" y="1075.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c52" value="&lt;b style=&quot;font-size:13px&quot;&gt;fabrikam analysts (bank): site-to-site VPN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;IPsec IKEv2 to hub VPN gateway, BGP off&lt;br&gt;home 172.16.40.0/24 NAT&amp;#x27;d to 100.64.12.0/24&lt;br&gt;(same stamp as acme; column not drawn)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="105.0" y="1164.0" width="330" height="80" as="geometry" /></mxCell><mxCell id="t1-c53" value="&lt;b style=&quot;font-size:13px&quot;&gt;woodgrove analysts (bank on Azure): Private Link&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;Private endpoint in woodgrove&amp;#x27;s OWN subscription&lt;br&gt;-&amp;gt; App Gateway Private Link. No hub routing,&lt;br&gt;IP overlap irrelevant (column not drawn)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="105.0" y="1258.0" width="330" height="97" as="geometry" /></mxCell><mxCell id="t1-c54" value="&lt;b style=&quot;font-size:13px&quot;&gt;meridian analysts (asset manager)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;Internet, from 198.51.100.0/24 only&lt;br&gt;NSG + WAF IP allow-list&lt;br&gt;meridian.ai.&amp;lt;domain&amp;gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="105.0" y="1369.0" width="330" height="80" as="geometry" /></mxCell><mxCell id="t1-c55" value="&lt;b style=&quot;font-size:13px&quot;&gt;Chatham engagement team&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;Corp network, Entra ID SSO + PIM&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="105.0" y="1463.0" width="330" height="50" as="geometry" /></mxCell><mxCell id="t1-c56" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure Front Door Premium (optional)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;Global edge for internet, multi-region&lt;br&gt;clients; WAF at edge; reaches the&lt;br&gt;client App Gateway via Private Link&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="105.0" y="1527.0" width="330" height="80" as="geometry" /></mxCell><mxCell id="t1-c57" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Front_Doors.svg;" vertex="1" parent="t1"><mxGeometry x="411.0" y="1532.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c58" value="&lt;b style=&quot;font-size:13px&quot;&gt;DNS (P&amp;amp;T)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;&amp;lt;client&amp;gt;.ai.&amp;lt;domain&amp;gt; -&amp;gt; App Gateway&lt;br&gt;private IP (x.x.2.10) in client spoke.&lt;br&gt;Client DNS forwards only its own zone&lt;br&gt;to the resolver inbound IP 10.0.1.4&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="105.0" y="1621.0" width="330" height="95" as="geometry" /></mxCell><mxCell id="t1-c59" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="t1"><mxGeometry x="411.0" y="1626.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c60" value="5" style="ellipse;html=1;fillColor=#6b5ca5;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t1"><mxGeometry x="414.0" y="1260.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t1-c61" value="Identity for end users" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=14;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="105.0" y="1745.0" width="178" height="20" as="geometry" /></mxCell><mxCell id="t1-c62" value="Client staff sign in to the app with Entra ID" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="105.0" y="1769.0" width="308" height="18" as="geometry" /></mxCell><mxCell id="t1-c63" value="(B2B guests or the client's own tenant via" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="105.0" y="1785.0" width="288" height="18" as="geometry" /></mxCell><mxCell id="t1-c64" value="app registration); app enforces roles." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="105.0" y="1801.0" width="261" height="18" as="geometry" /></mxCell><mxCell id="t1-c65" value="No user ever reaches a model, vault or" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="105.0" y="1817.0" width="261" height="18" as="geometry" /></mxCell><mxCell id="t1-c66" value="storage account directly." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="105.0" y="1833.0" width="174" height="18" as="geometry" /></mxCell><mxCell id="t1-c67" value="Operators" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=14;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="105.0" y="1875.0" width="77" height="20" as="geometry" /></mxCell><mxCell id="t1-c68" value="Readers: standing Reader + AKS RBAC Reader." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="105.0" y="1899.0" width="295" height="18" as="geometry" /></mxCell><mxCell id="t1-c69" value="Writers: PIM-elevated Contributor, time-" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="105.0" y="1915.0" width="275" height="18" as="geometry" /></mxCell><mxCell id="t1-c70" value="bound, approved. Bastion (hub) for private" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="105.0" y="1931.0" width="288" height="18" as="geometry" /></mxCell><mxCell id="t1-c71" value="AKS API / troubleshooting." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="105.0" y="1947.0" width="181" height="18" as="geometry" /></mxCell><mxCell id="t1-s70" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=2;" vertex="1" parent="t1"><mxGeometry x="470.0" y="1010.0" width="390" height="1468" as="geometry" /></mxCell><mxCell id="t1-c73" value="Connectivity subscription: hub VNet" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#3b74c4;" vertex="1" parent="t1"><mxGeometry x="484.0" y="1018.0" width="339" height="23" as="geometry" /></mxCell><mxCell id="t1-c74" value="Owned by P&amp;T (ADR 0002, 0003)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="484.0" y="1042.0" width="201" height="18" as="geometry" /></mxCell><mxCell id="t1-c75" value="&lt;b style=&quot;font-size:13px&quot;&gt;ExpressRoute gateway (ErGw1AZ)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;Client circuits linked by authorization key&lt;br&gt;VNet-to-VNet over circuits OFF;&lt;br&gt;no circuit-to-circuit transit&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="485.0" y="1080.0" width="360" height="80" as="geometry" /></mxCell><mxCell id="t1-c76" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Virtual_Network_Gateways.svg;" vertex="1" parent="t1"><mxGeometry x="821.0" y="1085.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c77" value="&lt;b style=&quot;font-size:13px&quot;&gt;VPN gateway (VpnGw2AZ, active-active)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;IPsec IKEv2 per client, BGP OFF so no&lt;br&gt;client learns another&amp;#x27;s routes;&lt;br&gt;static NAT for overlapping ranges&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="485.0" y="1174.0" width="360" height="80" as="geometry" /></mxCell><mxCell id="t1-c78" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Virtual_Network_Gateways.svg;" vertex="1" parent="t1"><mxGeometry x="821.0" y="1179.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c79" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure Firewall (Premium)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;0.0.0.0/0 from every spoke (UDR)&lt;br&gt;GatewaySubnet: each spoke -&amp;gt; firewall&lt;br&gt;One rule per client: its ranges -&amp;gt;&lt;br&gt;its own AGW IP:443. Default deny.&lt;br&gt;FQDN allow-list egress, IDPS&lt;br&gt;spoke-to-spoke DENIED&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="485.0" y="1268.0" width="360" height="125" as="geometry" /></mxCell><mxCell id="t1-c80" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Firewalls.svg;" vertex="1" parent="t1"><mxGeometry x="821.0" y="1273.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c81" value="&lt;b style=&quot;font-size:13px&quot;&gt;Private DNS Resolver&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;Spokes use it as DNS server&lt;br&gt;Inbound endpoint 10.0.1.4 for client&lt;br&gt;DNS conditional forwarders&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="485.0" y="1407.0" width="360" height="80" as="geometry" /></mxCell><mxCell id="t1-c82" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/DNS_Private_Resolver.svg;" vertex="1" parent="t1"><mxGeometry x="821.0" y="1412.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c83" value="&lt;b style=&quot;font-size:13px&quot;&gt;privatelink.* Private DNS zones&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;vaultcore, openai, blob, search,&lt;br&gt;cognitiveservices, azmk8s.io&lt;br&gt;Records created by DINE policy&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="485.0" y="1501.0" width="360" height="80" as="geometry" /></mxCell><mxCell id="t1-c84" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="t1"><mxGeometry x="821.0" y="1506.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c85" value="&lt;b style=&quot;font-size:13px&quot;&gt;Linked per-client zones&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;&amp;lt;client&amp;gt;.ai.&amp;lt;domain&amp;gt; -&amp;gt; AGW IP (routed&lt;br&gt;clients), &amp;lt;apim&amp;gt;.azure-api.net, ACA env&lt;br&gt;zone (linked to resolver VNet by P&amp;amp;T)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="485.0" y="1595.0" width="360" height="80" as="geometry" /></mxCell><mxCell id="t1-c86" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="t1"><mxGeometry x="821.0" y="1600.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c87" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure Bastion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;Jump path to private AKS API&lt;br&gt;and troubleshooting VMs&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="485.0" y="1689.0" width="360" height="65" as="geometry" /></mxCell><mxCell id="t1-c88" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Bastions.svg;" vertex="1" parent="t1"><mxGeometry x="821.0" y="1694.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c89" value="&lt;b style=&quot;font-size:13px&quot;&gt;DDoS Network Protection plan&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;Applied to public IPs by policy&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="485.0" y="1768.0" width="360" height="50" as="geometry" /></mxCell><mxCell id="t1-c90" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/DDoS_Protection_Plans.svg;" vertex="1" parent="t1"><mxGeometry x="821.0" y="1773.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c91" value="Hub &lt;-&gt; spoke VNet peering" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=14;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="485.0" y="1831.0" width="210" height="20" as="geometry" /></mxCell><mxCell id="t1-c92" value="Spoke side created by the stamp; hub side" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="485.0" y="1855.0" width="282" height="18" as="geometry" /></mxCell><mxCell id="t1-c93" value="by P&amp;T (modules/hub-connectivity). Gateway" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="485.0" y="1871.0" width="288" height="18" as="geometry" /></mxCell><mxCell id="t1-c94" value="transit only for ExpressRoute/VPN clients." style="text;html=1;al