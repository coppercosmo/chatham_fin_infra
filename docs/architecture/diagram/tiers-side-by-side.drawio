ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="5552.0" y="930.0" width="327" height="65" as="geometry" /></mxCell><mxCell id="t2-c90" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/analytics/Log_Analytics_Workspaces.svg;" vertex="1" parent="t2"><mxGeometry x="5855.0" y="935.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c91" value="&lt;b style=&quot;font-size:13px&quot;&gt;Key Vault&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;client secrets; CMK key&lt;br&gt;for storage + AOAI (option)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="5210.0" y="1020.0" width="327" height="65" as="geometry" /></mxCell><mxCell id="t2-c92" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="t2"><mxGeometry x="5513.0" y="1025.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c93" value="&lt;b style=&quot;font-size:13px&quot;&gt;Budget (resource group scope)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;plus showback of shared costs&lt;br&gt;from APIM token metrics&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="5552.0" y="1005.0" width="327" height="65" as="geometry" /></mxCell><mxCell id="t2-c94" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/general/Cost_Management.svg;" vertex="1" parent="t2"><mxGeometry x="5855.0" y="1010.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-s93" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=2;" vertex="1" parent="t2"><mxGeometry x="5195.0" y="1117.0" width="700" height="169" as="geometry" /></mxCell><mxCell id="t2-c96" value="rg-tailspin-prd-eus2" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#b7791f;" vertex="1" parent="t2"><mxGeometry x="5209.0" y="1125.0" width="196" height="23" as="geometry" /></mxCell><mxCell id="t2-c97" value="per client: client data, keys, models; deployed by id-deploy-tailspin" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="5209.0" y="1149.0" width="470" height="18" as="geometry" /></mxCell><mxCell id="t2-c98" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure OpenAI · Storage · Key Vault · Log Analytics&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;same shape as northwind; only tailspin&amp;#x27;s identities have roles&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="5210.0" y="1175.0" width="670" height="50" as="geometry" /></mxCell><mxCell id="t2-c99" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/ai_machine_learning/Azure_OpenAI.svg;" vertex="1" parent="t2"><mxGeometry x="5856.0" y="1180.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c100" value="&lt;b style=&quot;font-size:13px&quot;&gt;id-tailspin-app, id-tailspin-gw, budget&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="5210.0" y="1235.0" width="670" height="35" as="geometry" /></mxCell><mxCell id="t2-c101" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/identity/Managed_Identities.svg;" vertex="1" parent="t2"><mxGeometry x="5856.0" y="1240.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-s100" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=2;" vertex="1" parent="t2"><mxGeometry x="5195.0" y="1302.0" width="700" height="169" as="geometry" /></mxCell><mxCell id="t2-c103" value="rg-litware-prd-eus2" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#b7791f;" vertex="1" parent="t2"><mxGeometry x="5209.0" y="1310.0" width="187" height="23" as="geometry" /></mxCell><mxCell id="t2-c104" value="per client: client data, keys, models; deployed by id-deploy-litware" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="5209.0" y="1334.0" width="463" height="18" as="geometry" /></mxCell><mxCell id="t2-c105" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure OpenAI · Storage · Key Vault · Log Analytics&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;same shape as northwind; only litware&amp;#x27;s identities have roles&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="5210.0" y="1360.0" width="670" height="50" as="geometry" /></mxCell><mxCell id="t2-c106" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/ai_machine_learning/Azure_OpenAI.svg;" vertex="1" parent="t2"><mxGeometry x="5856.0" y="1365.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c107" value="&lt;b style=&quot;font-size:13px&quot;&gt;id-litware-app, id-litware-gw, budget&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="5210.0" y="1420.0" width="670" height="35" as="geometry" /></mxCell><mxCell id="t2-c108" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/identity/Managed_Identities.svg;" vertex="1" parent="t2"><mxGeometry x="5856.0" y="1425.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c109" value="Adding a client = a new client RG + one entry" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="5200.0" y="1479.0" width="334" height="19" as="geometry" /></mxCell><mxCell id="t2-c110" value="in the cell's clients map. No vending, no new" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="5200.0" y="1497.0" width="334" height="19" as="geometry" /></mxCell><mxCell id="t2-c111" value="gateway, no new environment." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="5200.0" y="1515.0" width="210" height="19" as="geometry" /></mxCell><mxCell id="t2-c112" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#6b5ca5;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="t2"><mxGeometry relative="1" as="geometry"><mxPoint x="3785.0" y="842.0" as="sourcePoint" /><mxPoint x="3835.0" y="1161.0" as="targetPoint" /><Array as="points"><mxPoint x="3810.0" y="842.0" /><mxPoint x="3810.0" y="1161.0" /></Array></mxGeometry></mxCell><mxCell id="t2-c113" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#6b5ca5;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="t2"><mxGeometry relative="1" as="geometry"><mxPoint x="4095.0" y="1143.0" as="sourcePoint" /><mxPoint x="4210.0" y="940.0" as="targetPoint" /><Array as="points"><mxPoint x="4124.0" y="1143.0" /><mxPoint x="4124.0" y="940.0" /></Array></mxGeometry></mxCell><mxCell id="t2-c114" value="1" style="ellipse;html=1;fillColor=#6b5ca5;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t2"><mxGeometry x="4112.0" y="1091.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t2-c115" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#6b5ca5;strokeWidth=2.2;endArrow=block;endFill=1;dashed=1;" edge="1" parent="t2"><mxGeometry relative="1" as="geometry"><mxPoint x="3785.0" y="952.0" as="sourcePoint" /><mxPoint x="4210.0" y="980.0" as="targetPoint" /><Array as="points"><mxPoint x="3804.0" y="952.0" /><mxPoint x="3804.0" y="791.0" /><mxPoint x="4140.0" y="791.0" /><mxPoint x="4140.0" y="980.0" /></Array></mxGeometry></mxCell><mxCell id="t2-c116" value="5" style="ellipse;html=1;fillColor=#6b5ca5;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t2"><mxGeometry x="4128.0" y="819.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t2-c117" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#6b5ca5;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="t2"><mxGeometry relative="1" as="geometry"><mxPoint x="4480.0" y="1016.0" as="sourcePoint" /><mxPoint x="4480.0" y="1111.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t2-c118" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#b7791f;strokeWidth=2.6;endArrow=block;endFill=1;" edge="1" parent="t2"><mxGeometry relative="1" as="geometry"><mxPoint x="4633.0" y="1111.0" as="sourcePoint" /><mxPoint x="4732.0" y="1016.0" as="targetPoint" /><Array as="points"><mxPoint x="4633.0" y="1076.0" /><mxPoint x="4732.0" y="1076.0" /></Array></mxGeometry></mxCell><mxCell id="t2-c119" value="2" style="ellipse;html=1;fillColor=#b7791f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t2"><mxGeometry x="4621.0" y="1094.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t2-c120" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#b7791f;strokeWidth=2.6;endArrow=block;endFill=1;" edge="1" parent="t2"><mxGeometry relative="1" as="geometry"><mxPoint x="5139.0" y="961.0" as="sourcePoint" /><mxPoint x="5210.0" y="881.0" as="targetPoint" /><Array as="points"><mxPoint x="5173.0" y="961.0" /><mxPoint x="5173.0" y="881.0" /></Array></mxGeometry></mxCell><mxCell id="t2-c121" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f8a68;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="t2"><mxGeometry relative="1" as="geometry"><mxPoint x="4480.0" y="1291.0" as="sourcePoint" /><mxPoint x="4480.0" y="1353.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t2-c122" value="3" style="ellipse;html=1;fillColor=#1f8a68;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t2"><mxGeometry x="4468.0" y="1295.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t2-c123" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f8a68;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="t2"><mxGeometry relative="1" as="geometry"><mxPoint x="4633.0" y="1435.0" as="sourcePoint" /><mxPoint x="5210.0" y="977.0" as="targetPoint" /><Array as="points"><mxPoint x="4633.0" y="1455.0" /><mxPoint x="5187.0" y="1455.0" /><mxPoint x="5187.0" y="977.0" /></Array></mxGeometry></mxCell><mxCell id="t2-c124" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#c0392b;strokeWidth=1.8;endArrow=block;endFill=1;dashed=1;" edge="1" parent="t2"><mxGeometry relative="1" as="geometry"><mxPoint x="4185.0" y="1187.0" as="sourcePoint" /><mxPoint x="4095.0" y="1187.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t2-c125" value="4" style="ellipse;html=1;fillColor=#c0392b;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t2"><mxGeometry x="4143.0" y="1175.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t2-c126" value="&lt;b style=&quot;font-size:14px&quot;&gt;How clients stay apart in a shared cell&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5b6675&quot;&gt;1. Data, keys and models are separate Azure resources per client, in the client&amp;#x27;s own resource group.&lt;br&gt;2. Each client has its own identities. Only id-&amp;lt;client&amp;gt;-app can use the client&amp;#x27;s storage, vault and index;&lt;br&gt;    only id-&amp;lt;client&amp;gt;-gw can call the client&amp;#x27;s Azure OpenAI. Keys are off everywhere, so a token is the only way in.&lt;br&gt;3. The gateway API for a client accepts only that client&amp;#x27;s app token and calls out only as that client&amp;#x27;s gateway identity.&lt;br&gt;4. Container apps accept traffic only from the App Gateway subnet, so one client&amp;#x27;s app can&amp;#x27;t call another&amp;#x27;s.&lt;br&gt;5. Per-client deployment identity: Contributor on its own resource group only. The cell identity has no data roles.&lt;br&gt;6. Terraform tests assert 1 to 5 for every client in the cell&amp;#x27;s clients map.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="3470.0" y="1740.0" width="803" height="148" as="geometry" /></mxCell><mxCell id="t2-c127" value="&lt;b style=&quot;font-size:14px&quot;&gt;What it costs (approx. list price, USD/month)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5b6675&quot;&gt;Shared per cell: App Gateway WAF_v2 ~400, APIM ~700 (Standard v2*), AI Search S1 x2 ~490,&lt;br&gt;Container Apps environment ~0 idle, cell Log Analytics ~50. About 1,650 per cell.&lt;br&gt;Per client: 3 private endpoints ~22, logs ~25, an always-on replica ~40, tokens as used.&lt;br&gt;About 90 per client + 1,650 / clients in the cell. At 20 clients: ~170 per client.&lt;br&gt;*Premium APIM (internal VNet mode, as built today) is ~2,800: ~280 per client at 20.&lt;br&gt;Tier 1 is ~700 to ~1,400 per client before tokens (~3,500 with a Premium gateway).&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="4288.0" y="1740.0" width="803" height="148" as="geometry" /></mxCell><mxCell id="t2-c128" value="&lt;b style=&quot;font-size:14px&quot;&gt;Fits / doesn&amp;#x27;t fit&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5b6675&quot;&gt;Fits: confidential client data where the contract accepts shared, Microsoft-managed&lt;br&gt;compute and edge, but wants dedicated data stores, keys, models and logs. Most hosted&lt;br&gt;solutions. Onboarding in hours, not days: no vending, no new gateway.&lt;br&gt;Doesn&amp;#x27;t fit: contracts that require a dedicated subscription, network-level separation,&lt;br&gt;their own ExpressRoute path with per-client firewall rules, or PTU capacity of their own.&lt;br&gt;Those clients stay on Tier 1. Moving up is a data copy plus a new stamp.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="5106.0" y="1740.0" width="803" height="148" as="geometry" /></mxCell><mxCell id="t2-c129" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#f3f1f8;strokeColor=#6b5ca5;strokeWidth=2;" vertex="1" parent="t2"><mxGeometry x="3470.0" y="1908.0" width="2440" height="184" as="geometry" /></mxCell><mxCell id="t2-c130" value="Legend" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#6b5ca5;" vertex="1" parent="t2"><mxGeometry x="3484.0" y="1916.0" width="63" height="23" as="geometry" /></mxCell><mxCell id="t2-c131" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=2;" vertex="1" parent="t2"><mxGeometry x="3490.0" y="1956.0" width="34" height="22" as="geometry" /></mxCell><mxCell id="t2-c132" value="Owned by Platform Engineering (P&amp;T)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="3534.0" y="1958.0" width="261" height="19" as="geometry" /></mxCell><mxCell id="t2-c133" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f4f6;strokeColor=#1f7f8c;strokeWidth=2;" vertex="1" parent="t2"><mxGeometry x="3809.0" y="1956.0" width="34" height="22" as="geometry" /></mxCell><mxCell id="t2-c134" value="Shared in the cell: carries client traffic, stores none" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="3853.0" y="1958.0" width="406" height="19" as="geometry" /></mxCell><mxCell id="t2-c135" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=2;" vertex="1" parent="t2"><mxGeometry x="4268.0" y="1956.0" width="34" height="22" as="geometry" /></mxCell><mxCell id="t2-c136" value="Per client: client data, keys, models, identities" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="4312.0" y="1958.0" width="363" height="19" as="geometry" /></mxCell><mxCell id="t2-c137" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3f1f8;strokeColor=#6b5ca5;strokeWidth=2;" vertex="1" parent="t2"><mxGeometry x="4685.0" y="1956.0" width="34" height="22" as="geometry" /></mxCell><mxCell id="t2-c138" value="Users" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="4729.0" y="1958.0" width="42" height="19" as="geometry" /></mxCell><mxCell id="t2-c139" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;" vertex="1" parent="t2"><mxGeometry x="4794.0" y="1956.0" width="34" height="22" as="geometry" /></mxCell><mxCell id="t2-c140" value="Key isolation control" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="4838.0" y="1958.0" width="159" height="19" as="geometry" /></mxCell><mxCell id="t2-c141" value="1" style="ellipse;html=1;fillColor=#6b5ca5;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t2"><mxGeometry x="3490.0" y="1989.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t2-c142" value="User path: client network -&gt; hub firewall -&gt; shared App Gateway (listener per client) -&gt; client's app" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="3520.0" y="1993.0" width="685" height="18" as="geometry" /></mxCell><mxCell id="t2-c143" value="2" style="ellipse;html=1;fillColor=#b7791f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t2"><mxGeometry x="4690.0" y="1989.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t2-c144" value="Model path: client's app -&gt; shared AI gateway (client's API) -&gt; client's own Azure OpenAI" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="4720.0" y="1993.0" width="604" height="18" as="geometry" /></mxCell><mxCell id="t2-c145" value="3" style="ellipse;html=1;fillColor=#1f8a68;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t2"><mxGeometry x="3490.0" y="2017.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t2-c146" value="Data path: client's app identity -&gt; its own storage, vault and search index (private endpoints)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="3520.0" y="2021.0" width="644" height="18" as="geometry" /></mxCell><mxCell id="t2-c147" value="4" style="ellipse;html=1;fillColor=#c0392b;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t2"><mxGeometry x="4690.0" y="2017.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t2-c148" value="Egress: cell workload subnets -&gt; hub firewall (UDR)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="4720.0" y="2021.0" width="349" height="18" as="geometry" /></mxCell><mxCell id="t2-c149" value="5" style="ellipse;html=1;fillColor=#6b5ca5;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t2"><mxGeometry x="3490.0" y="2045.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t2-c150" value="Private Link: client's own Azure VNet -&gt; private endpoint -&gt; cell App Gateway Private Link" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="3520.0" y="2049.0" width="611" height="18" as="geometry" /></mxCell><mxCell id="t2-c151" value="Sources: docs/adr/0014-isolation-tiers.md, docs/architecture/isolation-tiers.md, terraform/stamps/cell, terraform/stamps/cell-client. Names and addresses are the example configs." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="3490.0" y="2065.0" width="1202" height="18" as="geometry" /></mxCell><mxCell id="c525" value="" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c3cad4;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="3440" y="630" width="2500" height="1482" as="geometry"/></mxCell><mxCell id="c526" value="" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#7a8594;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="6020" y="290" width="2500" height="300" as="geometry"/></mxCell><mxCell id="c527" value="Tier 3: Pooled" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=60;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="6060" y="311" width="476" height="66" as="geometry"/></mxCell><mxCell id="c528" value="One app for many tenants; Azure checks the signed-in user&#x27;s own token on every data call" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=36;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="6060" y="393" width="1780" height="42" as="geometry"/></mxCell><mxCell id="c529" value="~USD 45 per tenant a month at 45 per pool  ·  public and internal data only  ·  blast radius: 45 tenants" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=32;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="6060" y="457" width="1870" height="38" as="geometry"/></mxCell><mxCell id="c530" value="Boundary: the user&#x27;s token; the app itself has no data role. Terraform: stamps/pool" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=32;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="6060" y="507" width="1493" height="38" as="geometry"/></mxCell><mxCell id="t3" value="Tier 3: Pooled" parent="0"/><mxCell id="t3-c2" value="Tier 3: pooled. One multi-tenant app for many clients; Azure enforces each client's data partition on the signed-in user's own token" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=26;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6050.0" y="649.0" width="1928" height="32" as="geometry" /></mxCell><mxCell id="t3-c3" value="ADR 0014. For low-sensitivity and standard-content solutions, trials and internal tools. Shared compute, stores and model deployments; per-client containers, indexes, encryption scopes, groups and token limits." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=15;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t3"><mxGeometry x="6050.0" y="686.0" width="1770" height="21" as="geometry" /></mxCell><mxCell id="t3-c4" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#f3f1f8;strokeColor=#6b5ca5;strokeWidth=2;" vertex="1" parent="t3"><mxGeometry x="6050.0" y="735.0" width="360" height="870" as="geometry" /></mxCell><mxCell id="t3-c5" value="Client users and identity" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#6b5ca5;" vertex="1" parent="t3"><mxGeometry x="6064.0" y="743.0" width="244" height="23" as="geometry" /></mxCell><mxCell id="t3-c6" value="&lt;b style=&quot;font-size:13px&quot;&gt;contoso users (own Entra tenant)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;sign in to the multi-tenant app&lt;br&gt;registration; tid = contoso&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6065.0" y="795.0" width="330" height="65" as="geometry" /></mxCell><mxCell id="t3-c7" value="&lt;b style=&quot;font-size:13px&quot;&gt;adatum users (B2B guests)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;guests in Chatham&amp;#x27;s tenant,&lt;br&gt;in group sg-aiadv-adatum-users&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6065.0" y="872.0" width="330" height="65" as="geometry" /></mxCell><mxCell id="t3-c8" value="&lt;b style=&quot;font-size:13px&quot;&gt;proseware users&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;same pattern&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6065.0" y="949.0" width="330" height="50" as="geometry" /></mxCell><mxCell id="t3-c9" value="&lt;b style=&quot;font-size:13px&quot;&gt;App registration: AI Advisory pooled app (P&amp;amp;T)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;app roles Tenant.contoso, Tenant.adatum ...&lt;br&gt;each client&amp;#x27;s group is assigned only its&lt;br&gt;own role; the role arrives in the token&lt;br&gt;exposes an API scope for on-behalf-of&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6065.0" y="1021.0" width="330" height="112" as="geometry" /></mxCell><mxCell id="t3-c10" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/identity/App_Registrations.svg;" vertex="1" parent="t3"><mxGeometry x="6371.0" y="1026.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t3-c11" value="&lt;b style=&quot;font-size:13px&quot;&gt;Entra ID groups (P&amp;amp;T)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;sg-aiadv-&amp;lt;tenant&amp;gt;-users per client:&lt;br&gt;the group IS the data permission&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6065.0" y="1145.0" width="330" height="65" as="geometry" /></mxCell><mxCell id="t3-c12" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/identity/Groups.svg;" vertex="1" parent="t3"><mxGeometry x="6371.0" y="1150.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t3-c13" value="The tenant is never taken from a header," style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6065.0" y="1229.0" width="275" height="18" as="geometry" /></mxCell><mxCell id="t3-c14" value="URL or request body: only from a signed" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6065.0" y="1247.0" width="268" height="18" as="geometry" /></mxCell><mxCell id="t3-c15" value="token claim." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6065.0" y="1265.0" width="87" height="18" as="geometry" /></mxCell><mxCell id="t3-c16" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=2;" vertex="1" parent="t3"><mxGeometry x="6430.0" y="735.0" width="260" height="870" as="geometry" /></mxCell><mxCell id="t3-c17" value="P&amp;T hub (shared)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#3b74c4;" vertex="1" parent="t3"><mxGeometry x="6444.0" y="743.0" width="158" height="23" as="geometry" /></mxCell><mxCell id="t3-c18" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure Firewall&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;egress allow-list for the pool&lt;br&gt;routed users -&amp;gt; pool AGW:443&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6445.0" y="795.0" width="230" height="65" as="geometry" /></mxCell><mxCell id="t3-c19" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Firewalls.svg;" vertex="1" parent="t3"><mxGeometry x="6651.0" y="800.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t3-c20" value="&lt;b style=&quot;font-size:13px&quot;&gt;DNS (P&amp;amp;T)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;advisor.ai.&amp;lt;domain&amp;gt; -&amp;gt; pool&lt;br&gt;App Gateway (one host name)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6445.0" y="874.0" width="230" height="65" as="geometry" /></mxCell><mxCell id="t3-c21" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="t3"><mxGeometry x="6651.0" y="879.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t3-c22" value="&lt;b style=&quot;font-size:13px&quot;&gt;privatelink.* Private DNS zones&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;records for the pool&amp;#x27;s private&lt;br&gt;endpoints (DINE policy)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6445.0" y="953.0" width="230" height="82" as="geometry" /></mxCell><mxCell id="t3-c23" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="t3"><mxGeometry x="6651.0" y="958.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t3-c24" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure Policy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;same guardrail initiative&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6445.0" y="1049.0" width="230" height="50" as="geometry" /></mxCell><mxCell id="t3-c25" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/management_governance/Policy.svg;" vertex="1" parent="t3"><mxGeometry x="6651.0" y="1054.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t3-c26" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#7a8594;strokeWidth=2;" vertex="1" parent="t3"><mxGeometry x="6735.0" y="735.0" width="1755" height="870" as="geometry" /></mxCell><mxCell id="t3-c27" value="sub: aiadv-pool-eus2-01   (terraform/stamps/pool: one state; tenants are entries in a map)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#7a8594;" vertex="1" parent="t3"><mxGeometry x="6749.0" y="743.0" width="863" height="23" as="geometry" /></mxCell><mxCell id="t3-c28" value="Every resource here is shared. Per-tenant pieces are sub-resources (containers, indexes, encryption scopes) or role assignments and limits, all created from the tenants map." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t3"><mxGeometry x="6749.0" y="767.0" width="1169" height="18" as="geometry" /></mxCell><mxCell id="t3-c29" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fffaf2;strokeColor=#c9954a;strokeWidth=1.5;" vertex="1" parent="t3"><mxGeometry x="6750.0" y="797.0" width="1060" height="560" as="geometry" /></mxCell><mxCell id="t3-c30" value="vnet-pool01-prd-eus2 (10.120.0.0/22), peered to the hub; 0.0.0.0/0 -&gt; hub firewall" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=1;fontColor=#c9954a;" vertex="1" parent="t3"><mxGeometry x="6762.0" y="805.0" width="603" height="19" as="geometry" /></mxCell><mxCell id="t3-c31" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9b98a;strokeWidth=1.5;dashed=1;dashPattern=5 3;" vertex="1" parent="t3"><mxGeometry x="6765.0" y="833.0" width="507" height="150" as="geometry" /></mxCell><mxCell id="t3-c32" value="snet-agw" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="t3"><mxGeometry x="6775.0" y="838.0" width="60" height="18" as="geometry" /></mxCell><mxCell id="t3-c33" value="&lt;b style=&quot;font-size:13px&quot;&gt;App Gateway WAF_v2 (pool)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;one listener: advisor.ai.&amp;lt;domain&amp;gt;&lt;br&gt;WAF policy + rate limit per client IP&lt;br&gt;no per-client certificates or listeners&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6f4f6;strokeColor=#1f7f8c;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6775.0" y="861.0" width="487" height="80" as="geometry" /></mxCell><mxCell id="t3-c34" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Application_Gateways.svg;" vertex="1" parent="t3"><mxGeometry x="7238.0" y="866.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t3-c35" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9b98a;strokeWidth=1.5;dashed=1;dashPattern=5 3;" vertex="1" parent="t3"><mxGeometry x="7287.0" y="833.0" width="507" height="150" as="geometry" /></mxCell><mxCell id="t3-c36" value="snet-apim" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="t3"><mxGeometry x="7297.0" y="838.0" width="66" height="18" as="geometry" /></mxCell><mxCell id="t3-c37" value="&lt;b style=&quot;font-size:13px&quot;&gt;AI gateway (APIM, internal, pool)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;validates the signed-in user&amp;#x27;s token&lt;br&gt;tenant = Tenant.&amp;lt;code&amp;gt; role claim&lt;br&gt;token limit + metric per tenant&lt;br&gt;calls the shared AOAI as its own identity&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="7297.0" y="861.0" width="487" height="95" as="geometry" /></mxCell><mxCell id="t3-c38" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/integration/API_Management_Services.svg;" vertex="1" parent="t3"><mxGeometry x="7760.0" y="866.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t3-c39" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9b98a;strokeWidth=1.5;dashed=1;dashPattern=5 3;" vertex="1" parent="t3"><mxGeometry x="6765.0" y="998.0" width="1030" height="220" as="geometry" /></mxCell><mxCell id="t3-c40" value="snet-apps: Container Apps environment (internal)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="t3"><mxGeometry x="6775.0" y="1003.0" width="329" height="18" as="geometry" /></mxCell><mxCell id="t3-c41" value="&lt;b style=&quot;font-size:13px&quot;&gt;ca-advisor (pooled, 2+ replicas)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;one app, every tenant; resolves the tenant from the&lt;br&gt;token&amp;#x27;s Tenant.&amp;lt;code&amp;gt; role, never from input&lt;br&gt;reads data with the user&amp;#x27;s token (on-behalf-of), so&lt;br&gt;Azure checks the user&amp;#x27;s group on every call&lt;br&gt;caches keyed by tenant + user; no shared answer cache&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6f4f6;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6775.0" y="1026.0" width="505" height="110" as="geometry" /></mxCell><mxCell id="t3-c42" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/other/Worker_Container_App.svg;" vertex="1" parent="t3"><mxGeometry x="7256.0" y="1031.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t3-c43" value="&lt;b style=&quot;font-size:13px&quot;&gt;job-ingest-&amp;lt;tenant&amp;gt; (one per tenant)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;background ingestion has no user, so each tenant&amp;#x27;s&lt;br&gt;job runs as its own id-&amp;lt;tenant&amp;gt;-ingest identity&lt;br&gt;with rights on that tenant&amp;#x27;s container and index only&lt;br&gt;pay per execution: near-zero idle cost&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="7295.0" y="1026.0" width="490" height="95" as="geometry" /></mxCell><mxCell id="t3-c44" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/other/Worker_Container_App.svg;" vertex="1" parent="t3"><mxGeometry x="7761.0" y="1031.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t3-c45" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9b98a;strokeWidth=1.5;dashed=1;dashPattern=5 3;" vertex="1" parent="t3"><mxGeometry x="6765.0" y="1233.0" width="1030" height="110" as="geometry" /></mxCell><mxCell id="t3-c46" value="snet-pe: private endpoints for the shared storage, search, AOAI and vault" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="t3"><mxGeometry x="6775.0" y="1238.0" width="497" height="18" as="geometry" /></mxCell><mxCell id="t3-c47" value="&lt;b style=&quot;font-size:13px&quot;&gt;pe-blob&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;keys off, public off&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6775.0" y="1265.0" width="241" height="50" as="geometry" /></mxCell><mxCell id="t3-c48" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="t3"><mxGeometry x="6992.0" y="1270.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t3-c49" value="&lt;b style=&quot;font-size:13px&quot;&gt;pe-search&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;keys off, public off&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="7031.0" y="1265.0" width="241" height="50" as="geometry" /></mxCell><mxCell id="t3-c50" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="t3"><mxGeometry x="7248.0" y="1270.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t3-c51" value="&lt;b style=&quot;font-size:13px&quot;&gt;pe-oai&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;keys off, public off&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="7287.0" y="1265.0" width="241" height="50" as="geometry" /></mxCell><mxCell id="t3-c52" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="t3"><mxGeometry x="7504.0" y="1270.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t3-c53" value="&lt;b style=&quot;font-size:13px&quot;&gt;pe-kv&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;keys off, public off&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="7543.0" y="1265.0" width="241" height="50" as="geometry" /></mxCell><mxCell id="t3-c54" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="t3"><mxGeometry x="7760.0" y="1270.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t3-c55" value="&lt;b style=&quot;font-size:13px&quot;&gt;Storage (pool): one container per tenant&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;RBAC at CONTAINER scope: sg-aiadv-contoso-users and&lt;br&gt;id-contoso-ingest on container contoso only&lt;br&gt;encryption scope per tenant (CMK option: revoke the&lt;br&gt;key to crypto-shred a tenant at offboarding)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6f4f6;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="7842.0" y="797.0" width="633" height="95" as="geometry" /></mxCell><mxCell id="t3-c56" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="t3"><mxGeometry x="8451.0" y="802.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t3-c57" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure AI Search (pool): one index per tenant&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;RBAC at INDEX scope for the tenant group + ingest id&lt;br&gt;queries run with the user&amp;#x27;s token, push only&lt;br&gt;(indexers would bypass index-level RBAC)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6f4f6;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="7842.0" y="904.0" width="633" height="80" as="geometry" /></mxCell><mxCell id="t3-c58" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/app_services/Search_Services.svg;" vertex="1" parent="t3"><mxGeometry x="8451.0" y="909.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t3-c59" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure OpenAI (pool): shared deployments&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;stateless calls only: store=false, no Assistants,&lt;br&gt;threads, files or stored completions&lt;br&gt;per-tenant fairness enforced at the gateway&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6f4f6;strokeColor=#1f7f8c;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="7842.0" y="996.0" width="633" height="80" as="geometry" /></mxCell><mxCell id="t3-c60" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/ai_machine_learning/Azure_OpenAI.svg;" vertex="1" parent="t3"><mxGeometry x="8451.0" y="1001.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t3-c61" value="&lt;b style=&quot;font-size:13px&quot;&gt;Key Vault (pool)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;encryption-scope keys per tenant, TLS cert&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6f4f6;strokeColor=#1f7f8c;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="7842.0" y="1088.0" width="633" height="50" as="geometry" /></mxCell><mxCell id="t3-c62" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="t3"><mxGeometry x="8451.0" y="1093.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t3-c63" value="&lt;b style=&quot;font-size:13px&quot;&gt;Log Analytics (pool)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;every row carries the tenant; no prompt bodies;&lt;br&gt;per-tenant export on request&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6f4f6;strokeColor=#1f7f8c;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="7842.0" y="1150.0" width="633" height="65" as="geometry" /></mxCell><mxCell id="t3-c64" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/analytics/Log_Analytics_Workspaces.svg;" vertex="1" parent="t3"><mxGeometry x="8451.0" y="1155.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t3-c65" value="&lt;b style=&quot;font-size:13px&quot;&gt;Per-tenant config (tenants map)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;container, index, encryption scope, group and&lt;br&gt;ingest identity, token limit, monthly token quota&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="7842.0" y="1227.0" width="633" height="65" as="geometry" /></mxCell><mxCell id="t3-c66" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#6b5ca5;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="t3"><mxGeometry relative="1" as="geometry"><mxPoint x="6395.0" y="827.0" as="sourcePoint" /><mxPoint x="6775.0" y="901.0" as="targetPoint" /><Array as="points"><mxPoint x="6420.0" y="827.0" /><mxPoint x="6420.0" y="1129.0" /><mxPoint x="6704.0" y="1129.0" /><mxPoint x="6704.0" y="901.0" /></Array></mxGeometry></mxCell><mxCell id="t3-c67" value="1" style="ellipse;html=1;fillColor=#6b5ca5;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t3"><mxGeometry x="6408.0" y="1077.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t3-c68" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#6b5ca5;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="t3"><mxGeometry relative="1" as="geometry"><mxPoint x="7222.0" y="941.0" as="sourcePoint" /><mxPoint x="7222.0" y="1026.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t3-c69" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f8a68;strokeWidth=2.4;endArrow=block;endFill=1;" edge="1" parent="t3"><mxGeometry relative="1" as="geometry"><mxPoint x="6815.0" y="1136.0" as="sourcePoint" /><mxPoint x="7842.0" y="827.0" as="targetPoint" /><Array as="points"><mxPoint x="6815.0" y="1150.0" /><mxPoint x="7818.0" y="1150.0" /><mxPoint x="7818.0" y="827.0" /></Array></mxGeometry></mxCell><mxCell id="t3-c70" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f8a68;strokeWidth=2.4;endArrow=block;endFill=1;" edge="1" parent="t3"><mxGeometry relative="1" as="geometry"><mxPoint x="7818.0" y="934.0" as="sourcePoint" /><mxPoint x="7842.0" y="934.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t3-c71" value="2" style="ellipse;html=1;fillColor=#1f8a68;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t3"><mxGeometry x="6803.0" y="1136.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t3-c72" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#b7791f;strokeWidth=2.6;endArrow=block;endFill=1;" edge="1" parent="t3"><mxGeometry relative="1" as="geometry"><mxPoint x="7240.0" y="1026.0" as="sourcePoint" /><mxPoint x="7347.0" y="956.0" as="targetPoint" /><Array as="points"><mxPoint x="7240.0" y="991.0" /><mxPoint x="7347.0" y="991.0" /></Array></mxGeometry></mxCell><mxCell id="t3-c73" value="3" style="ellipse;html=1;fillColor=#b7791f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t3"><mxGeometry x="7228.0" y="1007.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t3-c74" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#b7791f;strokeWidth=2.6;endArrow=block;endFill=1;" edge="1" parent="t3"><mxGeometry relative="1" as="geometry"><mxPoint x="7784.0" y="908.0" as="sourcePoint" /><mxPoint x="7842.0" y="1026.0" as="targetPoint" /><Array as="points"><mxPoint x="7826.0" y="908.0" /><mxPoint x="7826.0" y="1026.0" /></Array></mxGeometry></mxCell><mxCell id="t3-c75" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f8a68;strokeWidth=2;endArrow=block;endFill=1;dashed=1;" edge="1" parent="t3"><mxGeometry relative="1" as="geometry"><mxPoint x="7785.0" y="1056.0" as="sourcePoint" /><mxPoint x="7842.0" y="876.0" as="targetPoint" /><Array as="points"><mxPoint x="7834.0" y="1056.0" /><mxPoint x="7834.0" y="876.0" /></Array></mxGeometry></mxCell><mxCell id="t3-c76" value="4" style="ellipse;html=1;fillColor=#1f8a68;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t3"><mxGeometry x="7759.0" y="1111.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t3-c77" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#c0392b;strokeWidth=1.8;endArrow=block;endFill=1;dashed=1;" edge="1" parent="t3"><mxGeometry relative="1" as="geometry"><mxPoint x="6750.0" y="1317.0" as="sourcePoint" /><mxPoint x="6675.0" y="825.0" as="targetPoint" /><Array as="points"><mxPoint x="6720.0" y="1317.0" /><mxPoint x="6720.0" y="825.0" /></Array></mxGeometry></mxCell><mxCell id="t3-c78" value="5" style="ellipse;html=1;fillColor=#c0392b;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t3"><mxGeometry x="6708.0" y="1265.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t3-c79" value="&lt;b style=&quot;font-size:14px&quot;&gt;Why a bug in the pooled app can&amp;#x27;t read another tenant&amp;#x27;s documents&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5b6675&quot;&gt;A contoso user&amp;#x27;s token carries role Tenant.contoso and group sg-aiadv-contoso-users. The app exchanges it (on-behalf-of) for a storage token and a search token that are still that user&amp;#x27;s.&lt;br&gt;Storage holds a role assignment for sg-aiadv-contoso-users on container &amp;#x27;contoso&amp;#x27; only; Search on index &amp;#x27;contoso&amp;#x27; only. If the code asks for container &amp;#x27;adatum&amp;#x27;, Azure returns 403.&lt;br&gt;The app&amp;#x27;s own managed identity has NO data role on storage or search. It only pulls images and writes telemetry. Model calls carry the user&amp;#x27;s token to the gateway, which keys token limits on Tenant.&amp;lt;code&amp;gt;.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6750.0" y="1377.0" width="1060" height="132" as="geometry" /></mxCell><mxCell id="t3-c80" value="&lt;b style=&quot;font-size:14px&quot;&gt;What is weaker than Tiers 1 and 2 (say it first)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5b6675&quot;&gt;One process serves every tenant: a memory or cache bug could mix answers. Mitigated by tenant + user&lt;br&gt;cache keys and no semantic cache, not eliminated. One Azure OpenAI quota and one outage domain for&lt;br&gt;all tenants; gateway limits keep it fair. No per-tenant network path or CMK on logs. A regulator or&lt;br&gt;client who asks &amp;#x27;is anything of ours processed alongside other clients?&amp;#x27; gets a yes.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6050.0" y="1630.0" width="803" height="116" as="geometry" /></mxCell><mxCell id="t3-c81" value="&lt;b style=&quot;font-size:14px&quot;&gt;What it costs (approx. list price, USD/month)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5b6675&quot;&gt;Shared per pool: App Gateway ~400, APIM ~700 (Standard v2*), Search S1 x2 ~490, app replicas ~120,&lt;br&gt;Log Analytics ~80, Azure OpenAI pay per token. About 1,800 per pool.&lt;br&gt;Per tenant: a container, an index, an encryption scope, a group, a job identity: ~5 + tokens.&lt;br&gt;At 45 tenants (the cap, under S1&amp;#x27;s 50 indexes): ~45 per tenant. Onboarding: same day.&lt;br&gt;*Premium APIM (internal VNet mode, as built today) is ~2,800: ~90 per tenant at 45.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6868.0" y="1630.0" width="803" height="116" as="geometry" /></mxCell><mxCell id="t3-c82" value="&lt;b style=&quot;font-size:14px&quot;&gt;Fits / doesn&amp;#x27;t fit&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5b6675&quot;&gt;Fits: internal Chatham tools, standard-content products (market commentary, rate and hedge&lt;br&gt;explainers over Chatham&amp;#x27;s own research), trials and proofs of concept, small clients whose&lt;br&gt;data classification is internal or public and whose contract allows logical isolation.&lt;br&gt;Doesn&amp;#x27;t fit: confidential client documents, client-specific models or fine-tunes, PTU, CMK&lt;br&gt;requirements on everything, or a client-owned network path. Those go to Tier 2 or Tier 1.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="7686.0" y="1630.0" width="803" height="116" as="geometry" /></mxCell><mxCell id="t3-c83" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#f3f1f8;strokeColor=#6b5ca5;strokeWidth=2;" vertex="1" parent="t3"><mxGeometry x="6050.0" y="1766.0" width="2440" height="184" as="geometry" /></mxCell><mxCell id="t3-c84" value="Legend" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#6b5ca5;" vertex="1" parent="t3"><mxGeometry x="6064.0" y="1774.0" width="63" height="23" as="geometry" /></mxCell><mxCell id="t3-c85" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=2;" vertex="1" parent="t3"><mxGeometry x="6070.0" y="1814.0" width="34" height="22" as="geometry" /></mxCell><mxCell id="t3-c86" value="Owned by Platform Engineering (P&amp;T)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6114.0" y="1816.0" width="261" height="19" as="geometry" /></mxCell><mxCell id="t3-c87" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f4f6;strokeColor=#1f7f8c;strokeWidth=2;" vertex="1" parent="t3"><mxGeometry x="6389.0" y="1814.0" width="34" height="22" as="geometry" /></mxCell><mxCell id="t3-c88" value="Shared by every tenant in the pool" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6433.0" y="1816.0" width="254" height="19" as="geometry" /></mxCell><mxCell id="t3-c89" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=2;" vertex="1" parent="t3"><mxGeometry x="6701.0" y="1814.0" width="34" height="22" as="geometry" /></mxCell><mxCell id="t3-c90" value="Per tenant (partition, identity or limit)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6745.0" y="1816.0" width="304" height="19" as="geometry" /></mxCell><mxCell id="t3-c91" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3f1f8;strokeColor=#6b5ca5;strokeWidth=2;" vertex="1" parent="t3"><mxGeometry x="7062.0" y="1814.0" width="34" height="22" as="geometry" /></mxCell><mxCell id="t3-c92" value="Users" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="7106.0" y="1816.0" width="42" height="19" as="geometry" /></mxCell><mxCell id="t3-c93" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;" vertex="1" parent="t3"><mxGeometry x="7171.0" y="1814.0" width="34" height="22" as="geometry" /></mxCell><mxCell id="t3-c94" value="Key isolation control" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="7215.0" y="1816.0" width="159" height="19" as="geometry" /></mxCell><mxCell id="t3-c95" value="1" style="ellipse;html=1;fillColor=#6b5ca5;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t3"><mxGeometry x="6070.0" y="1847.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t3-c96" value="User path: one host name -&gt; pool App Gateway -&gt; pooled app (tenant from the token)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6100.0" y="1851.0" width="557" height="18" as="geometry" /></mxCell><mxCell id="t3-c97" value="2" style="ellipse;html=1;fillColor=#1f8a68;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t3"><mxGeometry x="7270.0" y="1847.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t3-c98" value="Data path on the user's own token: Azure checks container- and index-scoped roles" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="7300.0" y="1851.0" width="550" height="18" as="geometry" /></mxCell><mxCell id="t3-c99" value="3" style="ellipse;html=1;fillColor=#b7791f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t3"><mxGeometry x="6070.0" y="1875.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t3-c100" value="Model path: user's token -&gt; AI gateway (per-tenant limits) -&gt; shared Azure OpenAI" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6100.0" y="1879.0" width="550" height="18" as="geometry" /></mxCell><mxCell id="t3-c101" value="4" style="ellipse;html=1;fillColor=#1f8a68;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t3"><mxGeometry x="7270.0" y="1875.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t3-c102" value="Ingestion: per-tenant job identity -&gt; that tenant's container and index only" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="7300.0" y="1879.0" width="517" height="18" as="geometry" /></mxCell><mxCell id="t3-c103" value="5" style="ellipse;html=1;fillColor=#c0392b;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t3"><mxGeometry x="6070.0" y="1903.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t3-c104" value="Egress: pool workload subnets -&gt; hub firewall (UDR)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t3"><mxGeometry x="6100.0" y="1907.0" width="349" height="18" as="geometry" /></mxCell><mxCell id="t3-c105" value="Sources: docs/adr/0014-isolation-tiers.md, docs/architecture/isolation-tiers.md, terraform/stamps/pool. Names are the example config." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t3"><mxGeometry x="6070.0" y="1923.0" width="900" height="18" as="geometry" /></mxCell><mxCell id="c636" value="" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c3cad4;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="6020" y="630" width="2500" height="1340" as="geometry"/></mxCell><mxCell id="c637" value="Fixed costs are approximate US list prices (USD/month), with Standard v2 API Management, to show the shape of the saving. Details, cost math and the trade-offs of each tier: docs/architecture/isolation-tiers.md. Generated by generate_side_by_side.py from the three tier diagrams." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=28;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="60" y="3009" width="4381" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>