2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="1536.0" y="1134.0" width="259" height="148" as="geometry" /></mxCell><mxCell id="t1-c159" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Application_Gateways.svg;" vertex="1" parent="t1"><mxGeometry x="1771.0" y="1139.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c160" value="&lt;b style=&quot;font-size:12px&quot;&gt;WAF policy (per client)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5b6675&quot;&gt;Prevention mode; DRS 2.1 + Bot Manager 1.1&lt;br&gt;Prompt fields excluded from SQLI/XSS only&lt;br&gt;Rate limit per client IP&lt;br&gt;Access + firewall logs -&amp;gt; client LAW&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="1805.0" y="1134.0" width="259" height="148" as="geometry" /></mxCell><mxCell id="t1-s159" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9b98a;strokeWidth=1.5;dashed=1;dashPattern=5 3;" vertex="1" parent="t1"><mxGeometry x="1526.0" y="1302.0" width="548" height="232" as="geometry" /></mxCell><mxCell id="t1-c162" value="snet-apps  10.100.4.0/24   delegated to Microsoft.App/environments" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=11;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="1536.0" y="1308.0" width="413" height="17" as="geometry" /></mxCell><mxCell id="t1-c163" value="&lt;b style=&quot;font-size:12px&quot;&gt;Container Apps environment (internal LB, workload profiles)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5b6675&quot;&gt;modules/container-apps; zone redundant; static internal 