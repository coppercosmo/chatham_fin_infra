rts + budget&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5b6675&quot;&gt;AOAI 429 rate, tokens vs quota,&lt;br&gt;5xx, KV Forbidden&lt;br&gt;budget USD 5,000 / month&lt;br&gt;-&amp;gt; shared action group&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="1707.0" y="2238.0" width="185" height="120" as="geometry" /></mxCell><mxCell id="t1-c209" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/management_governance/Alerts.svg;" vertex="1" parent="t1"><mxGeometry x="1868.0" y="2243.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c210" value="&lt;b style=&quot;font-size:12px&quot;&gt;Locks + RBAC&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5b6675&quot;&gt;CanNotDelete on KV, storage,&lt;br&gt;AOAI&lt;br&gt;Reader group: standing&lt;br&gt;Operators: PIM only&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="1900.0" y="2238.0" width="185" height="120" as="geometry" /></mxCell><mxCell id="t1-c211" value="Config: terraform/clients/acme/  ~40 lines  |  state: tfstate-acme  |  deploy: id-deploy-acme" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=11;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="1514.0" y="2368.0" width="579" height="17" as="geometry" /></mxCell><mxCell id="t1-s210" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=2;" vertex="1" parent="t1"><mxGeometry x="2120.0" y="1010.0" width="600" height="1468" as="geometry" /></m