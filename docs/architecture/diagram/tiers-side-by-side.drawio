nt x="868.0" y="1344.0" /></Array></mxGeometry></mxCell><mxCell id="t1-c314" value="4" style="ellipse;html=1;fillColor=#c0392b;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t1"><mxGeometry x="856.0" y="1378.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t1-c315" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#f3f1f8;strokeColor=#6b5ca5;strokeWidth=2;" vertex="1" parent="t1"><mxGeometry x="90.0" y="2503.0" width="3240" height="290" as="geometry" /></mxCell><mxCell id="t1-c316" value="Delivery: GitHub Actions (ADR 0008) and GitOps" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#6b5ca5;" vertex="1" parent="t1"><mxGeometry x="104.0" y="2511.0" width="444" height="23" as="geometry" /></mxCell><mxCell id="t1-c317" value="Same pipeline for every client; each job can only ever authenticate as its own client" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="104.0" y="2535.0" width="577" height="18" as="geometry" /></mxCell><mxCell id="t1-c318" value="&lt;b style=&quot;font-size:13px&quot;&gt;Pull request&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;terraform fmt + validate&lt;br&gt;terraform test (mocked, offline)&lt;br&gt;client-config type-check&lt;br&gt;module tests, tflint, actionlint&lt;br&gt;Checkov (blocking)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="105.0" y="2565.0" width="389" height="150" as="geometry" /></mxCell><mxCell id="t1-c319" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f8a68;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="t1"><mxGeometry relative="1" as="geometry"><mxPoint x="494.0" y="2640.0" as="sourcePoint" /><mxPoint x="507.0" y="2640.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t1-c320" value="&lt;b style=&quot;font-size:13px&quot;&gt;Plan per affected client&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;env client-&amp;lt;c&amp;gt;-plan&lt;br&gt;OIDC -&amp;gt; id-plan-&amp;lt;c&amp;gt; (read-only)&lt;br&gt;module change = all clients&lt;br&gt;client change = that client&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="508.0" y="2565.0" width="389" height="150" as="geometry" /></mxCell><mxCell id="t1-c321" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f8a68;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="t1"><mxGeometry relative="1" as="geometry"><mxPoint x="897.0" y="2640.0" as="sourcePoint" /><mxPoint x="910.0" y="2640.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t1-c322" value="&lt;b style=&quot;font-size:13px&quot;&gt;Ring 0: chatham&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;auto on merge to main&lt;br&gt;canary + gateway pilot&lt;br&gt;evals, latency checks&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="911.0" y="2565.0" width="389" height="150" as="geometry" /></mxCell><mxCell id="t1-c323" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f8a68;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="t1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300.0" y="2640.0" as="sourcePoint" /><mxPoint x="1313.0" y="2640.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t1-c324" value="&lt;b style=&quot;font-size:13px&quot;&gt;Ring 1: acme (pilots)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;env client-acme&lt;br&gt;required reviewers&lt;br&gt;OIDC -&amp;gt; id-deploy-acme&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="1314.0" y="2565.0" width="389" height="150" as="geometry" /></mxCell><mxCell id="t1-c325" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f8a68;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="t1"><mxGeometry relative="1" as="geometry"><mxPoint x="1703.0" y="2640.0" as="sourcePoint" /><mxPoint x="1716.0" y="2640.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t1-c326" value="&lt;b style=&quot;font-size:13px&quot;&gt;Ring 2: everyone else&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;env client-&amp;lt;c&amp;gt;, approvals&lt;br&gt;max 5 parallel, fail-fast&lt;br&gt;e.g. meridian&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="1717.0" y="2565.0" width="389" height="150" as="geometry" /></mxCell><mxCell id="t1-c327" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f8a68;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="t1"><mxGeometry relative="1" as="geometry"><mxPoint x="2106.0" y="2640.0" as="sourcePoint" /><mxPoint x="2119.0" y="2640.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t1-c328" value="&lt;b style=&quot;font-size:13px&quot;&gt;Nightly drift&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;plan -detailed-exitcode&lt;br&gt;per client, read-only&lt;br&gt;opens a GitHub issue&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="2120.0" y="2565.0" width="389" height="150" as="geometry" /></mxCell><mxCell id="t1-c329" value="&lt;b style=&quot;font-size:13px&quot;&gt;Flux (AKS clients)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;reconciles kubernetes/&lt;br&gt;from Git inside the cluster&lt;br&gt;CI needs no access to the&lt;br&gt;private API server&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="2523.0" y="2565.0" width="389" height="150" as="geometry" /></mxCell><mxCell id="t1-c330" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/containers/Kubernetes_Services.svg;" vertex="1" parent="t1"><mxGeometry x="2888.0" y="2570.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t1-c331" value="&lt;b style=&quot;font-size:13px&quot;&gt;App releases&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;build once, sign, push to&lt;br&gt;ACR; promote the same&lt;br&gt;digest ring by ring&lt;br&gt;via app_image&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="2926.0" y="2565.0" width="389" height="150" as="geometry" /></mxCell><mxCell id="t1-c332" value="Apply identities: Contributor + RBAC Administrator limited by an ABAC condition to KV Secrets User, OpenAI User, Blob Data Contributor/Reader, Search Index Reader, Metrics Publisher, Reader, Network Contributor, Private DNS Zone Contributor, Managed Identity Operator, AKS RBAC Reader, Cognitive Services User (and AcrPull on the shared ACR only)." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="105.0" y="2730.0" width="2338" height="18" as="geometry" /></mxCell><mxCell id="t1-c333" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#f3f1f8;strokeColor=#6b5ca5;strokeWidth=2;" vertex="1" parent="t1"><mxGeometry x="90.0" y="2813.0" width="3240" height="145" as="geometry" /></mxCell><mxCell id="t1-c334" value="Legend" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#6b5ca5;" vertex="1" parent="t1"><mxGeometry x="104.0" y="2821.0" width="63" height="23" as="geometry" /></mxCell><mxCell id="t1-c335" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=2;" vertex="1" parent="t1"><mxGeometry x="110.0" y="2861.0" width="34" height="22" as="geometry" /></mxCell><mxCell id="t1-c336" value="Owned by Platform Engineering (P&amp;T)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="154.0" y="2863.0" width="261" height="19" as="geometry" /></mxCell><mxCell id="t1-c337" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e7f6f1;strokeColor=#1f8a68;strokeWidth=2;" vertex="1" parent="t1"><mxGeometry x="440.0" y="2861.0" width="34" height="22" as="geometry" /></mxCell><mxCell id="t1-c338" value="AI Advisory shared platform (no client data)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="484.0" y="2863.0" width="326" height="19" as="geometry" /></mxCell><mxCell id="t1-c339" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=2;" vertex="1" parent="t1"><mxGeometry x="770.0" y="2861.0" width="34" height="22" as="geometry" /></mxCell><mxCell id="t1-c340" value="Per client: client data, nothing shared" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="814.0" y="2863.0" width="290" height="19" as="geometry" /></mxCell><mxCell id="t1-c341" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3f1f8;strokeColor=#6b5ca5;strokeWidth=2;" vertex="1" parent="t1"><mxGeometry x="1100.0" y="2861.0" width="34" height="22" as="geometry" /></mxCell><mxCell id="t1-c342" value="Users, edge, GitHub" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="1144.0" y="2863.0" width="144" height="19" as="geometry" /></mxCell><mxCell id="t1-c343" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;" vertex="1" parent="t1"><mxGeometry x="1430.0" y="2861.0" width="34" height="22" as="geometry" /></mxCell><mxCell id="t1-c344" value="Key security control" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="1474.0" y="2863.0" width="152" height="19" as="geometry" /></mxCell><mxCell id="t1-c345" value="1" style="ellipse;html=1;fillColor=#6b5ca5;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t1"><mxGeometry x="1660.0" y="2860.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t1-c346" value="Private routed path: client network -&gt; ExpressRoute/VPN gateway -&gt; hub firewall (one rule per client) -&gt; App Gateway WAF" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="1690.0" y="2864.0" width="812" height="18" as="geometry" /></mxCell><mxCell id="t1-c347" value="2" style="ellipse;html=1;fillColor=#6b5ca5;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t1"><mxGeometry x="2420.0" y="2860.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t1-c348" value="Public user path (opt-in): internet -&gt; App Gateway public IP, NSG + WAF allow-list" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="2450.0" y="2864.0" width="557" height="18" as="geometry" /></mxCell><mxCell id="t1-c349" value="3" style="ellipse;html=1;fillColor=#b7791f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t1"><mxGeometry x="1660.0" y="2888.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t1-c350" value="Model path: app -&gt; AI gateway (Entra token) -&gt; Azure OpenAI private endpoint (gateway MI)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="1690.0" y="2892.0" width="604" height="18" as="geometry" /></mxCell><mxCell id="t1-c351" value="4" style="ellipse;html=1;fillColor=#c0392b;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t1"><mxGeometry x="2420.0" y="2888.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t1-c352" value="Egress: every spoke workload subnet -&gt; hub firewall (UDR); spoke-to-spoke denied" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="2450.0" y="2892.0" width="544" height="18" as="geometry" /></mxCell><mxCell id="t1-c353" value="5" style="ellipse;html=1;fillColor=#6b5ca5;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="t1"><mxGeometry x="1660.0" y="2916.0" width="24" height="24" as="geometry" /></mxCell><mxCell id="t1-c354" value="Private Link path: client's own Azure VNet -&gt; private endpoint -&gt; App Gateway Private Link (no hub routing)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="t1"><mxGeometry x="1690.0" y="2920.0" width="725" height="18" as="geometry" /></mxCell><mxCell id="t1-c355" value="Sources: docs/adr/0001-0013, terraform/stamps/client, terraform/modules/hub-connectivity, terraform/platform, terraform/clients/*. Addresses and names are the example configs; every value comes from a client's ~40-line tfvars." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t1"><mxGeometry x="110.0" y="2930.0" width="1525" height="18" as="geometry" /></mxCell><mxCell id="c368" value="" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c3cad4;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="3300" height="2348" as="geometry"/></mxCell><mxCell id="c369" value="" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#7a8594;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="3440" y="290" width="2500" height="300" as="geometry"/></mxCell><mxCell id="c370" value="Tier 2: Shared cell" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=60;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="3480" y="311" width="644" height="66" as="geometry"/></mxCell><mxCell id="c371" value="Shared front door, compute and AI gateway; data, keys and models stay per client" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=36;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="3480" y="393" width="1619" height="42" as="geometry"/></mxCell><mxCell id="c372" value="~USD 170 per client a month at 20 per cell  ·  up to confidential data  ·  blast radius: 20 clients" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=32;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="3480" y="457" width="1780" height="38" as="geometry"/></mxCell><mxCell id="c373" value="Boundary: own resource group, keys off, roles only for the client&#x27;s identities. Terraform: stamps/cell" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=32;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="3480" y="507" width="1834" height="38" as="geometry"/></mxCell><mxCell id="t2" value="Tier 2: Shared cell" parent="0"/><mxCell id="t2-c2" value="Tier 2: shared cell. Shared front door, compute and AI gateway; every client keeps its own data, keys, models and identities" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=26;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="3470.0" y="649.0" width="1811" height="32" as="geometry" /></mxCell><mxCell id="t2-c3" value="ADR 0014. One subscription (a 'cell') holds up to 20 clients. What's shared processes client traffic but stores none of it; everything that stores client data is per client and only that client's identities can use it." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=15;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="3470.0" y="686.0" width="1837" height="21" as="geometry" /></mxCell><mxCell id="t2-c4" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#f3f1f8;strokeColor=#6b5ca5;strokeWidth=2;" vertex="1" parent="t2"><mxGeometry x="3470.0" y="735.0" width="330" height="980" as="geometry" /></mxCell><mxCell id="t2-c5" value="Client users" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#6b5ca5;" vertex="1" parent="t2"><mxGeometry x="3484.0" y="743.0" width="120" height="23" as="geometry" /></mxCell><mxCell id="t2-c6" value="&lt;b style=&quot;font-size:13px&quot;&gt;northwind analysts: ExpressRoute or VPN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;through P&amp;amp;T&amp;#x27;s hub; firewall admits&lt;br&gt;northwind&amp;#x27;s ranges to the cell App&lt;br&gt;Gateway IP:443&lt;br&gt;northwind.ai.&amp;lt;domain&amp;gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="3485.0" y="795.0" width="300" height="95" as="geometry" /></mxCell><mxCell id="t2-c7" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Virtual_Network_Gateways.svg;" vertex="1" parent="t2"><mxGeometry x="3761.0" y="800.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c8" value="&lt;b style=&quot;font-size:13px&quot;&gt;tailspin analysts (on Azure): Private Link&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;private endpoint in tailspin&amp;#x27;s OWN&lt;br&gt;subscription -&amp;gt; cell App Gateway&lt;br&gt;Private Link frontend&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="3485.0" y="904.0" width="300" height="97" as="geometry" /></mxCell><mxCell id="t2-c9" value="&lt;b style=&quot;font-size:13px&quot;&gt;litware analysts: internet&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;public frontend, litware&amp;#x27;s egress&lt;br&gt;IPs only (per-site WAF allow-list)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="3485.0" y="1015.0" width="300" height="65" as="geometry" /></mxCell><mxCell id="t2-c10" value="Sign-in" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=14;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="3485.0" y="1105.0" width="61" height="20" as="geometry" /></mxCell><mxCell id="t2-c11" value="Each client app trusts only its own" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="3485.0" y="1129.0" width="241" height="18" as="geometry" /></mxCell><mxCell id="t2-c12" value="client's users (their Entra tenant or" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="3485.0" y="1145.0" width="255" height="18" as="geometry" /></mxCell><mxCell id="t2-c13" value="a B2B group). A user who reaches" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="3485.0" y="1161.0" width="221" height="18" as="geometry" /></mxCell><mxCell id="t2-c14" value="another client's host name gets a" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="3485.0" y="1177.0" width="228" height="18" as="geometry" /></mxCell><mxCell id="t2-c15" value="sign-in they can't pass." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="3485.0" y="1193.0" width="167" height="18" as="geometry" /></mxCell><mxCell id="t2-c16" value="Network separation is coarser" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=14;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="3485.0" y="1229.0" width="233" height="20" as="geometry" /></mxCell><mxCell id="t2-c17" value="All clients share one frontend IP, so" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="3485.0" y="1253.0" width="255" height="18" as="geometry" /></mxCell><mxCell id="t2-c18" value="the hub firewall and Private Link can't" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="3485.0" y="1269.0" width="268" height="18" as="geometry" /></mxCell><mxCell id="t2-c19" value="tell clients apart by address. The host" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="3485.0" y="1285.0" width="268" height="18" as="geometry" /></mxCell><mxCell id="t2-c20" value="name, per-site WAF rules and sign-in" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="3485.0" y="1301.0" width="248" height="18" as="geometry" /></mxCell><mxCell id="t2-c21" value="do. Clients that need network-level" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="3485.0" y="1317.0" width="241" height="18" as="geometry" /></mxCell><mxCell id="t2-c22" value="separation stay on Tier 1." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="3485.0" y="1333.0" width="181" height="18" as="geometry" /></mxCell><mxCell id="t2-c23" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=2;" vertex="1" parent="t2"><mxGeometry x="3820.0" y="735.0" width="290" height="980" as="geometry" /></mxCell><mxCell id="t2-c24" value="P&amp;T hub (shared)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#3b74c4;" vertex="1" parent="t2"><mxGeometry x="3834.0" y="743.0" width="158" height="23" as="geometry" /></mxCell><mxCell id="t2-c25" value="unchanged from Tier 1 (ADR 0013)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="3834.0" y="767.0" width="221" height="18" as="geometry" /></mxCell><mxCell id="t2-c26" value="&lt;b style=&quot;font-size:13px&quot;&gt;DNS (P&amp;amp;T)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;&amp;lt;client&amp;gt;.ai.&amp;lt;domain&amp;gt; -&amp;gt; the cell&lt;br&gt;App Gateway private IP&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="3835.0" y="805.0" width="260" height="65" as="geometry" /></mxCell><mxCell id="t2-c27" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="t2"><mxGeometry x="4071.0" y="810.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c28" value="&lt;b style=&quot;font-size:13px&quot;&gt;privatelink.* Private DNS zones&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;records for each client&amp;#x27;s private&lt;br&gt;endpoints, written by DINE policy&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="3835.0" y="884.0" width="260" height="65" as="geometry" /></mxCell><mxCell id="t2-c29" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="t2"><mxGeometry x="4071.0" y="889.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c30" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure Policy (AI Advisory MG)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;same guardrail initiative as Tier 1&lt;br&gt;(modules/policy-guardrails)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="3835.0" y="963.0" width="260" height="65" as="geometry" /></mxCell><mxCell id="t2-c31" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/management_governance/Policy.svg;" vertex="1" parent="t2"><mxGeometry x="4071.0" y="968.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c32" value="&lt;b style=&quot;font-size:13px&quot;&gt;Entra ID groups + PIM&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;per-client readers / operators&lt;br&gt;groups, scoped to the client RG&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="3835.0" y="1042.0" width="260" height="65" as="geometry" /></mxCell><mxCell id="t2-c33" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/identity/Groups.svg;" vertex="1" parent="t2"><mxGeometry x="4071.0" y="1047.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c34" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure Firewall&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;one rule per routed client:&lt;br&gt;its ranges -&amp;gt; cell AGW IP:443&lt;br&gt;default deny; egress inspected&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="3835.0" y="1121.0" width="260" height="80" as="geometry" /></mxCell><mxCell id="t2-c35" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Firewalls.svg;" vertex="1" parent="t2"><mxGeometry x="4071.0" y="1126.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c36" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#7a8594;strokeWidth=2;" vertex="1" parent="t2"><mxGeometry x="4155.0" y="735.0" width="1755" height="980" as="geometry" /></mxCell><mxCell id="t2-c37" value="sub: aiadv-cell-eus2-01   (terraform/stamps/cell + one terraform/stamps/cell-client per client)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#7a8594;" vertex="1" parent="t2"><mxGeometry x="4169.0" y="743.0" width="910" height="23" as="geometry" /></mxCell><mxCell id="t2-c38" value="Vended once by P&amp;T into the AI Advisory / Clients MG. A full cell gets a sibling: aiadv-cell-eus2-02." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="4169.0" y="767.0" width="685" height="18" as="geometry" /></mxCell><mxCell id="t2-c39" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#e6f4f6;strokeColor=#1f7f8c;strokeWidth=2;" vertex="1" parent="t2"><mxGeometry x="4170.0" y="797.0" width="1010" height="903" as="geometry" /></mxCell><mxCell id="t2-c40" value="rg-cell01-prd-eus2   (shared: carries client traffic, stores no client data)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#1f7f8c;" vertex="1" parent="t2"><mxGeometry x="4184.0" y="805.0" width="730" height="23" as="geometry" /></mxCell><mxCell id="t2-c41" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fffaf2;strokeColor=#c9954a;strokeWidth=1.5;" vertex="1" parent="t2"><mxGeometry x="4185.0" y="842.0" width="980" height="690" as="geometry" /></mxCell><mxCell id="t2-c42" value="vnet-cell01-prd-eus2 (10.110.0.0/22), peered to the hub; 0.0.0.0/0 -&gt; hub firewall" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=1;fontColor=#c9954a;" vertex="1" parent="t2"><mxGeometry x="4197.0" y="850.0" width="603" height="19" as="geometry" /></mxCell><mxCell id="t2-c43" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9b98a;strokeWidth=1.5;dashed=1;dashPattern=5 3;" vertex="1" parent="t2"><mxGeometry x="4200.0" y="878.0" width="467" height="190" as="geometry" /></mxCell><mxCell id="t2-c44" value="snet-agw /24" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="4210.0" y="883.0" width="87" height="18" as="geometry" /></mxCell><mxCell id="t2-c45" value="&lt;b style=&quot;font-size:13px&quot;&gt;App Gateway WAF_v2 (shared, multi-site)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;one listener, TLS certificate and WAF policy per client&lt;br&gt;host name picks the client&amp;#x27;s backend; require SNI&lt;br&gt;per-site WAF: client IP allow-list + rate limit&lt;br&gt;Private Link frontend for clients on Azure&lt;br&gt;access + WAF logs to the cell workspace, no bodies&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="4210.0" y="906.0" width="447" height="110" as="geometry" /></mxCell><mxCell id="t2-c46" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Application_Gateways.svg;" vertex="1" parent="t2"><mxGeometry x="4633.0" y="911.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c47" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9b98a;strokeWidth=1.5;dashed=1;dashPattern=5 3;" vertex="1" parent="t2"><mxGeometry x="4682.0" y="878.0" width="467" height="190" as="geometry" /></mxCell><mxCell id="t2-c48" value="snet-apim /26" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="4692.0" y="883.0" width="93" height="18" as="geometry" /></mxCell><mxCell id="t2-c49" value="&lt;b style=&quot;font-size:13px&quot;&gt;AI gateway (API Management, internal, shared)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;one API per client: /northwind/openai, /tailspin/...&lt;br&gt;accepts only that client&amp;#x27;s id-&amp;lt;client&amp;gt;-app token&lt;br&gt;calls that client&amp;#x27;s Azure OpenAI as id-&amp;lt;client&amp;gt;-gw&lt;br&gt;token limit + token metric per client (showback)&lt;br&gt;prompt and response bodies never logged&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="4692.0" y="906.0" width="447" height="110" as="geometry" /></mxCell><mxCell id="t2-c50" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/integration/API_Management_Services.svg;" vertex="1" parent="t2"><mxGeometry x="5115.0" y="911.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c51" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9b98a;strokeWidth=1.5;dashed=1;dashPattern=5 3;" vertex="1" parent="t2"><mxGeometry x="4200.0" y="1083.0" width="950" height="225" as="geometry" /></mxCell><mxCell id="t2-c52" value="snet-apps /24" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="4210.0" y="1088.0" width="93" height="18" as="geometry" /></mxCell><mxCell id="t2-c53" value="&lt;b style=&quot;font-size:13px&quot;&gt;Container Apps environment (internal, shared)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;workload profiles&lt;br&gt;one container app per&lt;br&gt;client, each with its own&lt;br&gt;user-assigned identity;&lt;br&gt;same image digest,&lt;br&gt;client set by CLIENT_CODE&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="4210.0" y="1111.0" width="215" height="180" as="geometry" /></mxCell><mxCell id="t2-c54" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/other/Container_App_Environments.svg;" vertex="1" parent="t2"><mxGeometry x="4401.0" y="1116.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c55" value="&lt;b style=&quot;font-size:13px&quot;&gt;ca-northwind&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;runs as id-northwind-app (no secrets)&lt;br&gt;ingress allows snet-agw only, so&lt;br&gt;apps can&amp;#x27;t call each other&lt;br&gt;min 1 replica&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="4440.0" y="1111.0" width="223" height="180" as="geometry" /></mxCell><mxCell id="t2-c56" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/other/Worker_Container_App.svg;" vertex="1" parent="t2"><mxGeometry x="4639.0" y="1116.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c57" value="&lt;b style=&quot;font-size:13px&quot;&gt;ca-tailspin&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;runs as id-tailspin-app (no secrets)&lt;br&gt;ingress allows snet-agw only, so&lt;br&gt;apps can&amp;#x27;t call each other&lt;br&gt;scale to zero&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="4678.0" y="1111.0" width="223" height="180" as="geometry" /></mxCell><mxCell id="t2-c58" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/other/Worker_Container_App.svg;" vertex="1" parent="t2"><mxGeometry x="4877.0" y="1116.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c59" value="&lt;b style=&quot;font-size:13px&quot;&gt;ca-litware&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;runs as id-litware-app (no secrets)&lt;br&gt;ingress allows snet-agw only, so&lt;br&gt;apps can&amp;#x27;t call each other&lt;br&gt;dedicated profile&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="4916.0" y="1111.0" width="223" height="180" as="geometry" /></mxCell><mxCell id="t2-c60" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/other/Worker_Container_App.svg;" vertex="1" parent="t2"><mxGeometry x="5115.0" y="1116.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c61" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9b98a;strokeWidth=1.5;dashed=1;dashPattern=5 3;" vertex="1" parent="t2"><mxGeometry x="4200.0" y="1323.0" width="950" height="190" as="geometry" /></mxCell><mxCell id="t2-c62" value="snet-pe /26" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="4210.0" y="1328.0" width="80" height="18" as="geometry" /></mxCell><mxCell id="t2-c63" value="&lt;b style=&quot;font-size:13px&quot;&gt;pe-search, pe-kv (cell)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;-&amp;gt; shared AI Search and&lt;br&gt;the cell&amp;#x27;s certificate vault&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="4210.0" y="1353.0" width="215" height="78" as="geometry" /></mxCell><mxCell id="t2-c64" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="t2"><mxGeometry x="4401.0" y="1358.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c65" value="&lt;b style=&quot;font-size:13px&quot;&gt;pe-northwind-oai / -kv / -blob&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;-&amp;gt; northwind&amp;#x27;s AOAI, vault,&lt;br&gt;storage only&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="4440.0" y="1353.0" width="223" height="82" as="geometry" /></mxCell><mxCell id="t2-c66" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="t2"><mxGeometry x="4639.0" y="1358.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c67" value="&lt;b style=&quot;font-size:13px&quot;&gt;pe-tailspin-oai / -kv / -blob&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;-&amp;gt; tailspin&amp;#x27;s AOAI, vault,&lt;br&gt;storage only&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="4678.0" y="1353.0" width="223" height="82" as="geometry" /></mxCell><mxCell id="t2-c68" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="t2"><mxGeometry x="4877.0" y="1358.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c69" value="&lt;b style=&quot;font-size:13px&quot;&gt;pe-litware-oai / -kv / -blob&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;-&amp;gt; litware&amp;#x27;s AOAI, vault,&lt;br&gt;storage only&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="4916.0" y="1353.0" width="223" height="78" as="geometry" /></mxCell><mxCell id="t2-c70" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="t2"><mxGeometry x="5115.0" y="1358.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c71" value="Each client's endpoints point only at that client's resources. Reaching an endpoint's IP is not access:" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#c0392b;" vertex="1" parent="t2"><mxGeometry x="4210.0" y="1468.0" width="698" height="18" as="geometry" /></mxCell><mxCell id="t2-c72" value="keys are off everywhere, and only Entra tokens for the client's own identities are accepted." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#c0392b;" vertex="1" parent="t2"><mxGeometry x="4210.0" y="1486.0" width="624" height="18" as="geometry" /></mxCell><mxCell id="t2-c73" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure AI Search (shared, S1, 2 replicas)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;one index per client, push only&lt;br&gt;index-scoped RBAC: each app can&lt;br&gt;read/write only its own index&lt;br&gt;no indexers (they bypass index RBAC)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="4185.0" y="1547.0" width="316" height="95" as="geometry" /></mxCell><mxCell id="t2-c74" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/app_services/Search_Services.svg;" vertex="1" parent="t2"><mxGeometry x="4477.0" y="1552.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c75" value="&lt;b style=&quot;font-size:13px&quot;&gt;Key Vault (cell)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;TLS certificates for client host&lt;br&gt;names only; read by id-cell-agw&lt;br&gt;no client secrets here&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="4516.0" y="1547.0" width="316" height="80" as="geometry" /></mxCell><mxCell id="t2-c76" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="t2"><mxGeometry x="4808.0" y="1552.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c77" value="&lt;b style=&quot;font-size:13px&quot;&gt;Log Analytics (cell)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;App Gateway, WAF, APIM and&lt;br&gt;environment logs; no prompt bodies;&lt;br&gt;platform ops group only&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="4847.0" y="1547.0" width="316" height="80" as="geometry" /></mxCell><mxCell id="t2-c78" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/analytics/Log_Analytics_Workspaces.svg;" vertex="1" parent="t2"><mxGeometry x="5139.0" y="1552.0" width="18" height="18" as="geometry" /></mxCell><mxCell id="t2-c79" value="Deployed by id-deploy-cell01 (shared RG + per-client wiring). It holds no role on any client's data." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="4185.0" y="1655.0" width="678" height="18" as="geometry" /></mxCell><mxCell id="t2-s78" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=2;" vertex="1" parent="t2"><mxGeometry x="5195.0" y="797.0" width="700" height="304" as="geometry" /></mxCell><mxCell id="t2-c81" value="rg-northwind-prd-eus2" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#b7791f;" vertex="1" parent="t2"><mxGeometry x="5209.0" y="805.0" width="206" height="23" as="geometry" /></mxCell><mxCell id="t2-c82" value="per client: client data, keys, models; deployed by id-deploy-northwind" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="t2"><mxGeometry x="5209.0" y="829.0" width="476" height="18" as="geometry" /></mxCell><mxCell id="t2-c83" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure OpenAI (northwind&amp;#x27;s own account)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;DataZoneStandard; capacity carved&lt;br&gt;from the cell&amp;#x27;s regional quota&lt;br&gt;trusts only id-northwind-gw&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="t2"><mxGeometry x="5210.0" y="855.0" width="327" height="80" as="geometry" /></mxCell><mxCell id="t2-c84" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/ai_machine_learning/Azure_OpenAI.svg;" vertex="1" parent="t2">