<mxfile host="tier3-pooled" type="device"><diagram id="tier3-pooled" name="Tier 3: pooled"><mxGraphModel dx="2500" dy="1340" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1340" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Tier 3: pooled. One multi-tenant app for many clients; Azure enforces each client&#x27;s data partition on the signed-in user&#x27;s own token" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=26;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="30" y="19" width="1928" height="32" as="geometry"/></mxCell><mxCell id="c3" value="ADR 0014. For low-sensitivity and standard-content solutions, trials and internal tools. Shared compute, stores and model deployments; per-client containers, indexes, encryption scopes, groups and token limits." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=15;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1770" height="21" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#f3f1f8;strokeColor=#6b5ca5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="105" width="360" height="870" as="geometry"/></mxCell><mxCell id="c5" value="Client users and identity" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#6b5ca5;" vertex="1" parent="1"><mxGeometry x="44" y="113" width="244" height="23" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style=&quot;font-size:13px&quot;&gt;contoso users (own Entra tenant)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;sign in to the multi-tenant app&lt;br&gt;registration; tid = contoso&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="45" y="165" width="330" height="65" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&quot;font-size:13px&quot;&gt;adatum users (B2B guests)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;guests in Chatham&amp;#x27;s tenant,&lt;br&gt;in group sg-aiadv-adatum-users&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="45" y="242" width="330" height="65" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style=&quot;font-size:13px&quot;&gt;proseware users&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;same pattern&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="45" y="319" width="330" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style=&quot;font-size:13px&quot;&gt;App registration: AI Advisory pooled app (P&amp;amp;T)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;app roles Tenant.contoso, Tenant.adatum ...&lt;br&gt;each client&amp;#x27;s group is assigned only its&lt;br&gt;own role; the role arrives in the token&lt;br&gt;exposes an API scope for on-behalf-of&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="45" y="391" width="330" height="112" as="geometry"/></mxCell><mxCell id="c10" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/identity/App_Registrations.svg;" vertex="1" parent="1"><mxGeometry x="351" y="396" width="18" height="18" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style=&quot;font-size:13px&quot;&gt;Entra ID groups (P&amp;amp;T)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;sg-aiadv-&amp;lt;tenant&amp;gt;-users per client:&lt;br&gt;the group IS the data permission&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="45" y="515" width="330" height="65" as="geometry"/></mxCell><mxCell id="c12" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/identity/Groups.svg;" vertex="1" parent="1"><mxGeometry x="351" y="520" width="18" height="18" as="geometry"/></mxCell><mxCell id="c13" value="The tenant is never taken from a header," style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="45" y="599" width="275" height="18" as="geometry"/></mxCell><mxCell id="c14" value="URL or request body: only from a signed" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="45" y="617" width="268" height="18" as="geometry"/></mxCell><mxCell id="c15" value="token claim." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="45" y="635" width="87" height="18" as="geometry"/></mxCell><mxCell id="c16" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="410" y="105" width="260" height="870" as="geometry"/></mxCell><mxCell id="c17" value="P&amp;T hub (shared)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#3b74c4;" vertex="1" parent="1"><mxGeometry x="424" y="113" width="158" height="23" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure Firewall&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;egress allow-list for the pool&lt;br&gt;routed users -&amp;gt; pool AGW:443&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="425" y="165" width="230" height="65" as="geometry"/></mxCell><mxCell id="c19" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Firewalls.svg;" vertex="1" parent="1"><mxGeometry x="631" y="170" width="18" height="18" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style=&quot;font-size:13px&quot;&gt;DNS (P&amp;amp;T)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;advisor.ai.&amp;lt;domain&amp;gt; -&amp;gt; pool&lt;br&gt;App Gateway (one host name)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="425" y="244" width="230" height="65" as="geometry"/></mxCell><mxCell id="c21" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="1"><mxGeometry x="631" y="249" width="18" height="18" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b style=&quot;font-size:13px&quot;&gt;privatelink.* Private DNS zones&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;records for the pool&amp;#x27;s private&lt;br&gt;endpoints (DINE policy)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="425" y="323" width="230" height="82" as="geometry"/></mxCell><mxCell id="c23" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="1"><mxGeometry x="631" y="328" width="18" height="18" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure Policy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;same guardrail initiative&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="425" y="419" width="230" height="50" as="geometry"/></mxCell><mxCell id="c25" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/management_governance/Policy.svg;" vertex="1" parent="1"><mxGeometry x="631" y="424" width="18" height="18" as="geometry"/></mxCell><mxCell id="c26" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#7a8594;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="715" y="105" width="1755" height="870" as="geometry"/></mxCell><mxCell id="c27" value="sub: aiadv-pool-eus2-01   (terraform/stamps/pool: one state; tenants are entries in a map)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#7a8594;" vertex="1" parent="1"><mxGeometry x="729" y="113" width="863" height="23" as="geometry"/></mxCell><mxCell id="c28" value="Every resource here is shared. Per-tenant pieces are sub-resources (containers, indexes, encryption scopes) or role assignments and limits, all created from the tenants map." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="729" y="137" width="1169" height="18" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fffaf2;strokeColor=#c9954a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="730" y="167" width="1060" height="560" as="geometry"/></mxCell><mxCell id="c30" value="vnet-pool01-prd-eus2 (10.120.0.0/22), peered to the hub; 0.0.0.0/0 -&gt; hub firewall" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=1;fontColor=#c9954a;" vertex="1" parent="1"><mxGeometry x="742" y="175" width="603" height="19" as="geometry"/></mxCell><mxCell id="c31" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9b98a;strokeWidth=1.5;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="745" y="203" width="507" height="150" as="geometry"/></mxCell><mxCell id="c32" value="snet-agw" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="755" y="208" width="60" height="18" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b style=&quot;font-size:13px&quot;&gt;App Gateway WAF_v2 (pool)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;one listener: advisor.ai.&amp;lt;domain&amp;gt;&lt;br&gt;WAF policy + rate limit per client IP&lt;br&gt;no per-client certificates or listeners&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6f4f6;strokeColor=#1f7f8c;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="755" y="231" width="487" height="80" as="geometry"/></mxCell><mxCell id="c34" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Application_Gateways.svg;" vertex="1" parent="1"><mxGeometry x="1218" y="236" width="18" height="18" as="geometry"/></mxCell><mxCell id="c35" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9b98a;strokeWidth=1.5;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="1267" y="203" width="507" height="150" as="geometry"/></mxCell><mxCell id="c36" value="snet-apim" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="1277" y="208" width="66" height="18" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b style=&quot;font-size:13px&quot;&gt;AI gateway (APIM, internal, pool)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;validates the signed-in user&amp;#x27;s token&lt;br&gt;tenant = Tenant.&amp;lt;code&amp;gt; role claim&lt;br&gt;token limit + metric per tenant&lt;br&gt;calls the shared AOAI as its own identity&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1277" y="231" width="487" height="95" as="geometry"/></mxCell><mxCell id="c38" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/integration/API_Management_Services.svg;" vertex="1" parent="1"><mxGeometry x="1740" y="236" width="18" height="18" as="geometry"/></mxCell><mxCell id="c39" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9b98a;strokeWidth=1.5;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="745" y="368" width="1030" height="220" as="geometry"/></mxCell><mxCell id="c40" value="snet-apps: Container Apps environment (internal)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="755" y="373" width="329" height="18" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b style=&quot;font-size:13px&quot;&gt;ca-advisor (pooled, 2+ replicas)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;one app, every tenant; resolves the tenant from the&lt;br&gt;token&amp;#x27;s Tenant.&amp;lt;code&amp;gt; role, never from input&lt;br&gt;reads data with the user&amp;#x27;s token (on-behalf-of), so&lt;br&gt;Azure checks the user&amp;#x27;s group on every call&lt;br&gt;caches keyed by tenant + user; no shared answer cache&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6f4f6;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="755" y="396" width="505" height="110" as="geometry"/></mxCell><mxCell id="c42" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/other/Worker_Container_App.svg;" vertex="1" parent="1"><mxGeometry x="1236" y="401" width="18" height="18" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b style=&quot;font-size:13px&quot;&gt;job-ingest-&amp;lt;tenant&amp;gt; (one per tenant)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;background ingestion has no user, so each tenant&amp;#x27;s&lt;br&gt;job runs as its own id-&amp;lt;tenant&amp;gt;-ingest identity&lt;br&gt;with rights on that tenant&amp;#x27;s container and index only&lt;br&gt;pay per execution: near-zero idle cost&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1275" y="396" width="490" height="95" as="geometry"/></mxCell><mxCell id="c44" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/other/Worker_Container_App.svg;" vertex="1" parent="1"><mxGeometry x="1741" y="401" width="18" height="18" as="geometry"/></mxCell><mxCell id="c45" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9b98a;strokeWidth=1.5;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="745" y="603" width="1030" height="110" as="geometry"/></mxCell><mxCell id="c46" value="snet-pe: private endpoints for the shared storage, search, AOAI and vault" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="755" y="608" width="497" height="18" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b style=&quot;font-size:13px&quot;&gt;pe-blob&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;keys off, public off&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="755" y="635" width="241" height="50" as="geometry"/></mxCell><mxCell id="c48" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="972" y="640" width="18" height="18" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b style=&quot;font-size:13px&quot;&gt;pe-search&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;keys off, public off&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1011" y="635" width="241" height="50" as="geometry"/></mxCell><mxCell id="c50" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="1228" y="640" width="18" height="18" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b style=&quot;font-size:13px&quot;&gt;pe-oai&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;keys off, public off&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1267" y="635" width="241" height="50" as="geometry"/></mxCell><mxCell id="c52" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="1484" y="640" width="18" height="18" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b style=&quot;font-size:13px&quot;&gt;pe-kv&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;keys off, public off&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1523" y="635" width="241" height="50" as="geometry"/></mxCell><mxCell id="c54" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="1740" y="640" width="18" height="18" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b style=&quot;font-size:13px&quot;&gt;Storage (pool): one container per tenant&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;RBAC at CONTAINER scope: sg-aiadv-contoso-users and&lt;br&gt;id-contoso-ingest on container contoso only&lt;br&gt;encryption scope per tenant (CMK option: revoke the&lt;br&gt;key to crypto-shred a tenant at offboarding)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6f4f6;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1822" y="167" width="633" height="95" as="geometry"/></mxCell><mxCell id="c56" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="2431" y="172" width="18" height="18" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure AI Search (pool): one index per tenant&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;RBAC at INDEX scope for the tenant group + ingest id&lt;br&gt;queries run with the user&amp;#x27;s token, push only&lt;br&gt;(indexers would bypass index-level RBAC)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6f4f6;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1822" y="274" width="633" height="80" as="geometry"/></mxCell><mxCell id="c58" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/app_services/Search_Services.svg;" vertex="1" parent="1"><mxGeometry x="2431" y="279" width="18" height="18" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure OpenAI (pool): shared deployments&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;stateless calls only: store=false, no Assistants,&lt;br&gt;threads, files or stored completions&lt;br&gt;per-tenant fairness enforced at the gateway&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6f4f6;strokeColor=#1f7f8c;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1822" y="366" width="633" height="80" as="geometry"/></mxCell><mxCell id="c60" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/ai_machine_learning/Azure_OpenAI.svg;" vertex="1" parent="1"><mxGeometry x="2431" y="371" width="18" height="18" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b style=&quot;font-size:13px&quot;&gt;Key Vault (pool)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;encryption-scope keys per tenant, TLS cert&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6f4f6;strokeColor=#1f7f8c;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1822" y="458" width="633" height="50" as="geometry"/></mxCell><mxCell id="c62" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="2431" y="463" width="18" height="18" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b style=&quot;font-size:13px&quot;&gt;Log Analytics (pool)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;every row carries the tenant; no prompt bodies;&lt;br&gt;per-tenant export on request&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6f4f6;strokeColor=#1f7f8c;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1822" y="520" width="633" height="65" as="geometry"/></mxCell><mxCell id="c64" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/analytics/Log_Analytics_Workspaces.svg;" vertex="1" parent="1"><mxGeometry x="2431" y="525" width="18" height="18" as="geometry"/></mxCell><mxCell id="c65" value="&lt;b style=&quot;font-size:13px&quot;&gt;Per-tenant config (tenants map)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;container, index, encryption scope, group and&lt;br&gt;ingest identity, token limit, monthly token quota&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1822" y="597" width="633" height="65" as="geometry"/></mxCell><mxCell id="c66" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#6b5ca5;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="197" as="sourcePoint"/><mxPoint x="755" y="271" as="targetPoint"/><Array as="points"><mxPoint x="400" y="197"/><mxPoint x="400" y="499"/><mxPoint x="684" y="499"/><mxPoint x="684" y="271"/></Array></mxGeometry></mxCell><mxCell id="c67" value="1" style="ellipse;html=1;fillColor=#6b5ca5;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="388" y="447" width="24" height="24" as="geometry"/></mxCell><mxCell id="c68" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#6b5ca5;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1202" y="311" as="sourcePoint"/><mxPoint x="1202" y="396" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c69" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f8a68;strokeWidth=2.4;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="795" y="506" as="sourcePoint"/><mxPoint x="1822" y="197" as="targetPoint"/><Array as="points"><mxPoint x="795" y="520"/><mxPoint x="1798" y="520"/><mxPoint x="1798" y="197"/></Array></mxGeometry></mxCell><mxCell id="c70" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f8a68;strokeWidth=2.4;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1798" y="304" as="sourcePoint"/><mxPoint x="1822" y="304" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c71" value="2" style="ellipse;html=1;fillColor=#1f8a68;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="783" y="506" width="24" height="24" as="geometry"/></mxCell><mxCell id="c72" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#b7791f;strokeWidth=2.6;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="396" as="sourcePoint"/><mxPoint x="1327" y="326" as="targetPoint"/><Array as="points"><mxPoint x="1220" y="361"/><mxPoint x="1327" y="361"/></Array></mxGeometry></mxCell><mxCell id="c73" value="3" style="ellipse;html=1;fillColor=#b7791f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1208" y="377" width="24" height="24" as="geometry"/></mxCell><mxCell id="c74" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#b7791f;strokeWidth=2.6;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1764" y="278" as="sourcePoint"/><mxPoint x="1822" y="396" as="targetPoint"/><Array as="points"><mxPoint x="1806" y="278"/><mxPoint x="1806" y="396"/></Array></mxGeometry></mxCell><mxCell id="c75" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f8a68;strokeWidth=2;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1765" y="426" as="sourcePoint"/><mxPoint x="1822" y="246" as="targetPoint"/><Array as="points"><mxPoint x="1814" y="426"/><mxPoint x="1814" y="246"/></Array></mxGeometry></mxCell><mxCell id="c76" value="4" style="ellipse;html=1;fillColor=#1f8a68;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1739" y="481" width="24" height="24" as="geometry"/></mxCell><mxCell id="c77" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#c0392b;strokeWidth=1.8;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="687" as="sourcePoint"/><mxPoint x="655" y="195" as="targetPoint"/><Array as="points"><mxPoint x="700" y="687"/><mxPoint x="700" y="195"/></Array></mxGeometry></mxCell><mxCell id="c78" value="5" style="ellipse;html=1;fillColor=#c0392b;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="688" y="635" width="24" height="24" as="geometry"/></mxCell><mxCell id="c79" value="&lt;b style=&quot;font-size:14px&quot;&gt;Why a bug in the pooled app can&amp;#x27;t read another tenant&amp;#x27;s documents&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5b6675&quot;&gt;A contoso user&amp;#x27;s token carries role Tenant.contoso and group sg-aiadv-contoso-users. The app exchanges it (on-behalf-of) for a storage token and a search token that are still that user&amp;#x27;s.&lt;br&gt;Storage holds a role assignment for sg-aiadv-contoso-users on container &amp;#x27;contoso&amp;#x27; only; Search on index &amp;#x27;contoso&amp;#x27; only. If the code asks for container &amp;#x27;adatum&amp;#x27;, Azure returns 403.&lt;br&gt;The app&amp;#x27;s own managed identity has NO data role on storage or search. It only pulls images and writes telemetry. Model calls carry the user&amp;#x27;s token to the gateway, which keys token limits on Tenant.&amp;lt;code&amp;gt;.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="730" y="747" width="1060" height="132" as="geometry"/></mxCell><mxCell id="c80" value="&lt;b style=&quot;font-size:14px&quot;&gt;What is weaker than Tiers 1 and 2 (say it first)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5b6675&quot;&gt;One process serves every tenant: a memory or cache bug could mix answers. Mitigated by tenant + user&lt;br&gt;cache keys and no semantic cache, not eliminated. One Azure OpenAI quota and one outage domain for&lt;br&gt;all tenants; gateway limits keep it fair. No per-tenant network path or CMK on logs. A regulator or&lt;br&gt;client who asks &amp;#x27;is anything of ours processed alongside other clients?&amp;#x27; gets a yes.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="30" y="1000" width="803" height="116" as="geometry"/></mxCell><mxCell id="c81" value="&lt;b style=&quot;font-size:14px&quot;&gt;What it costs (approx. list price, USD/month)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5b6675&quot;&gt;Shared per pool: App Gateway ~400, APIM ~700 (Standard v2*), Search S1 x2 ~490, app replicas ~120,&lt;br&gt;Log Analytics ~80, Azure OpenAI pay per token. About 1,800 per pool.&lt;br&gt;Per tenant: a container, an index, an encryption scope, a group, a job identity: ~5 + tokens.&lt;br&gt;At 45 tenants (the cap, under S1&amp;#x27;s 50 indexes): ~45 per tenant. Onboarding: same day.&lt;br&gt;*Premium APIM (internal VNet mode, as built today) is ~2,800: ~90 per tenant at 45.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="848" y="1000" width="803" height="116" as="geometry"/></mxCell><mxCell id="c82" value="&lt;b style=&quot;font-size:14px&quot;&gt;Fits / doesn&amp;#x27;t fit&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5b6675&quot;&gt;Fits: internal Chatham tools, standard-content products (market commentary, rate and hedge&lt;br&gt;explainers over Chatham&amp;#x27;s own research), trials and proofs of concept, small clients whose&lt;br&gt;data classification is internal or public and whose contract allows logical isolation.&lt;br&gt;Doesn&amp;#x27;t fit: confidential client documents, client-specific models or fine-tunes, PTU, CMK&lt;br&gt;requirements on everything, or a client-owned network path. Those go to Tier 2 or Tier 1.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1666" y="1000" width="803" height="116" as="geometry"/></mxCell><mxCell id="c83" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#f3f1f8;strokeColor=#6b5ca5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="1136" width="2440" height="184" as="geometry"/></mxCell><mxCell id="c84" value="Legend" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#6b5ca5;" vertex="1" parent="1"><mxGeometry x="44" y="1144" width="63" height="23" as="geometry"/></mxCell><mxCell id="c85" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="1184" width="34" height="22" as="geometry"/></mxCell><mxCell id="c86" value="Owned by Platform Engineering (P&amp;T)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="94" y="1186" width="261" height="19" as="geometry"/></mxCell><mxCell id="c87" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f4f6;strokeColor=#1f7f8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="369" y="1184" width="34" height="22" as="geometry"/></mxCell><mxCell id="c88" value="Shared by every tenant in the pool" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="413" y="1186" width="254" height="19" as="geometry"/></mxCell><mxCell id="c89" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="681" y="1184" width="34" height="22" as="geometry"/></mxCell><mxCell id="c90" value="Per tenant (partition, identity or limit)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="725" y="1186" width="304" height="19" as="geometry"/></mxCell><mxCell id="c91" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3f1f8;strokeColor=#6b5ca5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1042" y="1184" width="34" height="22" as="geometry"/></mxCell><mxCell id="c92" value="Users" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1086" y="1186" width="42" height="19" as="geometry"/></mxCell><mxCell id="c93" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1151" y="1184" width="34" height="22" as="geometry"/></mxCell><mxCell id="c94" value="Key isolation control" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1195" y="1186" width="159" height="19" as="geometry"/></mxCell><mxCell id="c95" value="1" style="ellipse;html=1;fillColor=#6b5ca5;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="1217" width="24" height="24" as="geometry"/></mxCell><mxCell id="c96" value="User path: one host name -&gt; pool App Gateway -&gt; pooled app (tenant from the token)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="80" y="1221" width="557" height="18" as="geometry"/></mxCell><mxCell id="c97" value="2" style="ellipse;html=1;fillColor=#1f8a68;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1250" y="1217" width="24" height="24" as="geometry"/></mxCell><mxCell id="c98" value="Data path on the user&#x27;s own token: Azure checks container- and index-scoped roles" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1280" y="1221" width="550" height="18" as="geometry"/></mxCell><mxCell id="c99" value="3" style="ellipse;html=1;fillColor=#b7791f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="1245" width="24" height="24" as="geometry"/></mxCell><mxCell id="c100" value="Model path: user&#x27;s token -&gt; AI gateway (per-tenant limits) -&gt; shared Azure OpenAI" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="80" y="1249" width="550" height="18" as="geometry"/></mxCell><mxCell id="c101" value="4" style="ellipse;html=1;fillColor=#1f8a68;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1250" y="1245" width="24" height="24" as="geometry"/></mxCell><mxCell id="c102" value="Ingestion: per-tenant job identity -&gt; that tenant&#x27;s container and index only" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1280" y="1249" width="517" height="18" as="geometry"/></mxCell><mxCell id="c103" value="5" style="ellipse;html=1;fillColor=#c0392b;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="1273" width="24" height="24" as="geometry"/></mxCell><mxCell id="c104" value="Egress: pool workload subnets -&gt; hub firewall (UDR)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="80" y="1277" width="349" height="18" as="geometry"/></mxCell><mxCell id="c105" value="Sources: docs/adr/0014-isolation-tiers.md, docs/architecture/isolation-tiers.md, terraform/stamps/pool. Names are the example config." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="50" y="1293" width="900" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>