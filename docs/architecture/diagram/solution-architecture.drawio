 client LAW&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="2365" y="504" width="259" height="148" as="geometry"/></mxCell><mxCell id="s213" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9b98a;strokeWidth=1.5;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="2086" y="672" width="548" height="288" as="geometry"/></mxCell><mxCell id="c216" value="snet-aks  10.100.8.0/24   nodes only; pods in overlay 192.168.0.0/16" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=11;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="2096" y="678" width="425" height="17" as="geometry"/></mxCell><mxCell id="c217" value="&lt;b style=&quot;font-size:12px&quot;&gt;AKS private cluster (modules/aks), Standard tier&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5b6675&quot;&gt;Entra ID only + Azure RBAC, local accounts off; API server via private DNS (P&amp;amp;T azmk8s zone)&lt;br&gt;CNI Overlay + Cilium; UDR egress; Azure Policy add-on; Key Vault CSI; patch auto-upgrade&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="2096" y="700" width="528" height="62" as="geometry"/></mxCell><mxCell id="c218" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/containers/Kubernetes_Services.svg;" vertex="1" parent="1"><mxGeometry x="2600" y="705" width="18" height="18" as="geometry"/></mxCell><mxCell id="c219" value="&lt;b style=&quot;font-size:12px&quot;&gt;system pool&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font