" height="150" as="geometry"/></mxCell><mxCell id="c308" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f8a68;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="434" y="2010" as="sourcePoint"/><mxPoint x="447" y="2010" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c309" value="&lt;b style=&quot;font-size:13px&quot;&gt;Plan per affected client&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;env client-&amp;lt;c&amp;gt;-plan&lt;br&gt;OIDC -&amp;gt; id-plan-&amp;lt;c&amp;gt; (read-only)&lt;br&gt;module change = all clients&lt;br&gt;client change = that client&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="448" y="1935" width="389" height="150" as="geometry"/></mxCell><mxCell id="c310" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f8a68;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="837" y="2010" as="sourcePoint"/><mxPoint x="850" y="2010" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c311" value="&lt;b style=&quot;font-size:13px&quot;&gt;Ring 0: chatham&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;auto on merge to main&lt;br&gt;canary + gateway pilot&lt;br&gt;evals, latency checks&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="851" y="1935" width="389" height="150" as="geometry"/></mxCell><mxCell id="c312" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f8a68;strokeWidth=2.2;endArrow=block;endFill=