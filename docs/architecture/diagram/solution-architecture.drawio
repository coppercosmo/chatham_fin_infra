<mxfile host="generate.py" type="device"><diagram id="solution-architecture" name="Solution architecture"><mxGraphModel dx="3300" dy="2318" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="2318" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Chatham AI Advisory hosting platform on Azure: multi-client solution architecture" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=28;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="30" y="17" width="1276" height="34" as="geometry"/></mxCell><mxCell id="c3" value="One subscription per client (ADR 0001), built from the same Terraform stamp, inside Platform Engineering&#x27;s landing zone. Every client resource below is private; nothing is shared between clients." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=15;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1644" height="21" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="95" width="3240" height="235" as="geometry"/></mxCell><mxCell id="c5" value="Entra ID tenant and governance  (owned by Platform Engineering / P&amp;T)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#3b74c4;" vertex="1" parent="1"><mxGeometry x="44" y="103" width="663" height="23" as="geometry"/></mxCell><mxCell id="c6" value="ADR 0002: AI Advisory is a landing-zone consumer. P&amp;T owns hierarchy, policy, identity and connectivity; we build inside their guardrails." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="