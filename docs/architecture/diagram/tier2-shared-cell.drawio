<mxfile host="tier2-shared-cell" type="device"><diagram id="tier2-shared-cell" name="Tier 2: shared cell"><mxGraphModel dx="2500" dy="1482" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1482" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Tier 2: shared cell. Shared front door, compute and AI gateway; every client keeps its own data, keys, models and identities" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=26;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="30" y="19" width="1811" height="32" as="geometry"/></mxCell><mxCell id="c3" value="ADR 0014. One subscription (a &#x27;cell&#x27;) holds up to 20 clients. What&#x27;s shared processes client traffic but stores none of it; everything that stores client data is per client and only that client&#x27;s identities can use it." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=15;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1837" height="21" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#f3f1f8;strokeColor=#6b5ca5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="105" width="330" height="980" as="geometry"/></mxCell><mxCell id="c5" value="Client users" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#6b5ca5;" vertex="1" parent="1"><mxGeometry x="44" y="113" width="120" height="23" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style=&quot;font-size:13px&quot;&gt;northwind analysts: ExpressRoute or VPN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;through P&amp;amp;T&amp;#x27;s hub; firewall admits&lt;br&gt;northwind&amp;#x27;s ranges to the cell App&lt;br&gt;Gateway IP:443&lt;br&gt;northwind.ai.&amp;lt;domain&amp;gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="45" y="165" width="300" height="95" as="geometry"/></mxCell><mxCell id="c7" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Virtual_Network_Gateways.svg;" vertex="1" parent="1"><mxGeometry x="321" y="170" width="18" height="18" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style=&quot;font-size:13px&quot;&gt;tailspin analysts (on Azure): Private Link&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;private endpoint in tailspin&amp;#x27;s OWN&lt;br&gt;subscription -&amp;gt; cell App Gateway&lt;br&gt;Private Link frontend&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="45" y="274" width="300" height="97" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style=&quot;font-size:13px&quot;&gt;litware analysts: internet&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;public frontend, litware&amp;#x27;s egress&lt;br&gt;IPs only (per-site WAF allow-list)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="45" y="385" width="300" height="65" as="geometry"/></mxCell><mxCell id="c10" value="Sign-in" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=14;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="45" y="475" width="61" height="20" as="geometry"/></mxCell><mxCell id="c11" value="Each client app trusts only its own" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="45" y="499" width="241" height="18" as="geometry"/></mxCell><mxCell id="c12" value="client&#x27;s users (their Entra tenant or" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="45" y="515" width="255" height="18" as="geometry"/></mxCell><mxCell id="c13" value="a B2B group). A user who reaches" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="45" y="531" width="221" height="18" as="geometry"/></mxCell><mxCell id="c14" value="another client&#x27;s host name gets a" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="45" y="547" width="228" height="18" as="geometry"/></mxCell><mxCell id="c15" value="sign-in they can&#x27;t pass." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="45" y="563" width="167" height="18" as="geometry"/></mxCell><mxCell id="c16" value="Network separation is coarser" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=14;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="45" y="599" width="233" height="20" as="geometry"/></mxCell><mxCell id="c17" value="All clients share one frontend IP, so" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="45" y="623" width="255" height="18" as="geometry"/></mxCell><mxCell id="c18" value="the hub firewall and Private Link can&#x27;t" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="45" y="639" width="268" height="18" as="geometry"/></mxCell><mxCell id="c19" value="tell clients apart by address. The host" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="45" y="655" width="268" height="18" as="geometry"/></mxCell><mxCell id="c20" value="name, per-site WAF rules and sign-in" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="45" y="671" width="248" height="18" as="geometry"/></mxCell><mxCell id="c21" value="do. Clients that need network-level" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="45" y="687" width="241" height="18" as="geometry"/></mxCell><mxCell id="c22" value="separation stay on Tier 1." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="45" y="703" width="181" height="18" as="geometry"/></mxCell><mxCell id="c23" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="105" width="290" height="980" as="geometry"/></mxCell><mxCell id="c24" value="P&amp;T hub (shared)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#3b74c4;" vertex="1" parent="1"><mxGeometry x="394" y="113" width="158" height="23" as="geometry"/></mxCell><mxCell id="c25" value="unchanged from Tier 1 (ADR 0013)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="394" y="137" width="221" height="18" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b style=&quot;font-size:13px&quot;&gt;DNS (P&amp;amp;T)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;&amp;lt;client&amp;gt;.ai.&amp;lt;domain&amp;gt; -&amp;gt; the cell&lt;br&gt;App Gateway private IP&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="395" y="175" width="260" height="65" as="geometry"/></mxCell><mxCell id="c27" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="1"><mxGeometry x="631" y="180" width="18" height="18" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b style=&quot;font-size:13px&quot;&gt;privatelink.* Private DNS zones&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;records for each client&amp;#x27;s private&lt;br&gt;endpoints, written by DINE policy&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="395" y="254" width="260" height="65" as="geometry"/></mxCell><mxCell id="c29" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="1"><mxGeometry x="631" y="259" width="18" height="18" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure Policy (AI Advisory MG)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;same guardrail initiative as Tier 1&lt;br&gt;(modules/policy-guardrails)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="395" y="333" width="260" height="65" as="geometry"/></mxCell><mxCell id="c31" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/management_governance/Policy.svg;" vertex="1" parent="1"><mxGeometry x="631" y="338" width="18" height="18" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b style=&quot;font-size:13px&quot;&gt;Entra ID groups + PIM&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;per-client readers / operators&lt;br&gt;groups, scoped to the client RG&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="395" y="412" width="260" height="65" as="geometry"/></mxCell><mxCell id="c33" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/identity/Groups.svg;" vertex="1" parent="1"><mxGeometry x="631" y="417" width="18" height="18" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure Firewall&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;one rule per routed client:&lt;br&gt;its ranges -&amp;gt; cell AGW IP:443&lt;br&gt;default deny; egress inspected&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="395" y="491" width="260" height="80" as="geometry"/></mxCell><mxCell id="c35" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Firewalls.svg;" vertex="1" parent="1"><mxGeometry x="631" y="496" width="18" height="18" as="geometry"/></mxCell><mxCell id="c36" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#7a8594;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="715" y="105" width="1755" height="980" as="geometry"/></mxCell><mxCell id="c37" value="sub: aiadv-cell-eus2-01   (terraform/stamps/cell + one terraform/stamps/cell-client per client)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#7a8594;" vertex="1" parent="1"><mxGeometry x="729" y="113" width="910" height="23" as="geometry"/></mxCell><mxCell id="c38" value="Vended once by P&amp;T into the AI Advisory / Clients MG. A full cell gets a sibling: aiadv-cell-eus2-02." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="729" y="137" width="685" height="18" as="geometry"/></mxCell><mxCell id="c39" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#e6f4f6;strokeColor=#1f7f8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="167" width="1010" height="903" as="geometry"/></mxCell><mxCell id="c40" value="rg-cell01-prd-eus2   (shared: carries client traffic, stores no client data)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#1f7f8c;" vertex="1" parent="1"><mxGeometry x="744" y="175" width="730" height="23" as="geometry"/></mxCell><mxCell id="c41" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fffaf2;strokeColor=#c9954a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="745" y="212" width="980" height="690" as="geometry"/></mxCell><mxCell id="c42" value="vnet-cell01-prd-eus2 (10.110.0.0/22), peered to the hub; 0.0.0.0/0 -&gt; hub firewall" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=1;fontColor=#c9954a;" vertex="1" parent="1"><mxGeometry x="757" y="220" width="603" height="19" as="geometry"/></mxCell><mxCell id="c43" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9b98a;strokeWidth=1.5;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="760" y="248" width="467" height="190" as="geometry"/></mxCell><mxCell id="c44" value="snet-agw /24" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="770" y="253" width="87" height="18" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b style=&quot;font-size:13px&quot;&gt;App Gateway WAF_v2 (shared, multi-site)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;one listener, TLS certificate and WAF policy per client&lt;br&gt;host name picks the client&amp;#x27;s backend; require SNI&lt;br&gt;per-site WAF: client IP allow-list + rate limit&lt;br&gt;Private Link frontend for clients on Azure&lt;br&gt;access + WAF logs to the cell workspace, no bodies&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="770" y="276" width="447" height="110" as="geometry"/></mxCell><mxCell id="c46" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Application_Gateways.svg;" vertex="1" parent="1"><mxGeometry x="1193" y="281" width="18" height="18" as="geometry"/></mxCell><mxCell id="c47" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9b98a;strokeWidth=1.5;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="1242" y="248" width="467" height="190" as="geometry"/></mxCell><mxCell id="c48" value="snet-apim /26" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="1252" y="253" width="93" height="18" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b style=&quot;font-size:13px&quot;&gt;AI gateway (API Management, internal, shared)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;one API per client: /northwind/openai, /tailspin/...&lt;br&gt;accepts only that client&amp;#x27;s id-&amp;lt;client&amp;gt;-app token&lt;br&gt;calls that client&amp;#x27;s Azure OpenAI as id-&amp;lt;client&amp;gt;-gw&lt;br&gt;token limit + token metric per client (showback)&lt;br&gt;prompt and response bodies never logged&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1252" y="276" width="447" height="110" as="geometry"/></mxCell><mxCell id="c50" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/integration/API_Management_Services.svg;" vertex="1" parent="1"><mxGeometry x="1675" y="281" width="18" height="18" as="geometry"/></mxCell><mxCell id="c51" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9b98a;strokeWidth=1.5;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="760" y="453" width="950" height="225" as="geometry"/></mxCell><mxCell id="c52" value="snet-apps /24" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="770" y="458" width="93" height="18" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b style=&quot;font-size:13px&quot;&gt;Container Apps environment (internal, shared)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;workload profiles&lt;br&gt;one container app per&lt;br&gt;client, each with its own&lt;br&gt;user-assigned identity;&lt;br&gt;same image digest,&lt;br&gt;client set by CLIENT_CODE&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="770" y="481" width="215" height="180" as="geometry"/></mxCell><mxCell id="c54" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/other/Container_App_Environments.svg;" vertex="1" parent="1"><mxGeometry x="961" y="486" width="18" height="18" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b style=&quot;font-size:13px&quot;&gt;ca-northwind&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;runs as id-northwind-app (no secrets)&lt;br&gt;ingress allows snet-agw only, so&lt;br&gt;apps can&amp;#x27;t call each other&lt;br&gt;min 1 replica&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1000" y="481" width="223" height="180" as="geometry"/></mxCell><mxCell id="c56" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/other/Worker_Container_App.svg;" vertex="1" parent="1"><mxGeometry x="1199" y="486" width="18" height="18" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b style=&quot;font-size:13px&quot;&gt;ca-tailspin&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;runs as id-tailspin-app (no secrets)&lt;br&gt;ingress allows snet-agw only, so&lt;br&gt;apps can&amp;#x27;t call each other&lt;br&gt;scale to zero&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1238" y="481" width="223" height="180" as="geometry"/></mxCell><mxCell id="c58" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/other/Worker_Container_App.svg;" vertex="1" parent="1"><mxGeometry x="1437" y="486" width="18" height="18" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b style=&quot;font-size:13px&quot;&gt;ca-litware&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;runs as id-litware-app (no secrets)&lt;br&gt;ingress allows snet-agw only, so&lt;br&gt;apps can&amp;#x27;t call each other&lt;br&gt;dedicated profile&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1476" y="481" width="223" height="180" as="geometry"/></mxCell><mxCell id="c60" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/other/Worker_Container_App.svg;" vertex="1" parent="1"><mxGeometry x="1675" y="486" width="18" height="18" as="geometry"/></mxCell><mxCell id="c61" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9b98a;strokeWidth=1.5;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="760" y="693" width="950" height="190" as="geometry"/></mxCell><mxCell id="c62" value="snet-pe /26" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=1;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="770" y="698" width="80" height="18" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b style=&quot;font-size:13px&quot;&gt;pe-search, pe-kv (cell)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;-&amp;gt; shared AI Search and&lt;br&gt;the cell&amp;#x27;s certificate vault&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="770" y="723" width="215" height="78" as="geometry"/></mxCell><mxCell id="c64" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="961" y="728" width="18" height="18" as="geometry"/></mxCell><mxCell id="c65" value="&lt;b style=&quot;font-size:13px&quot;&gt;pe-northwind-oai / -kv / -blob&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;-&amp;gt; northwind&amp;#x27;s AOAI, vault,&lt;br&gt;storage only&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1000" y="723" width="223" height="82" as="geometry"/></mxCell><mxCell id="c66" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="1199" y="728" width="18" height="18" as="geometry"/></mxCell><mxCell id="c67" value="&lt;b style=&quot;font-size:13px&quot;&gt;pe-tailspin-oai / -kv / -blob&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675&quot;&gt;-&amp;gt; tailspin&amp;#x27;s AOAI, vault,&lt;br&gt;storage only&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbf3e