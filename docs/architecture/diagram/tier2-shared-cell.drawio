t=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1770" y="730" width="670" height="50" as="geometry"/></mxCell><mxCell id="c106" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/ai_machine_learning/Azure_OpenAI.svg;" vertex="1" parent="1"><mxGeometry x="2416" y="735" width="18" height="18" as="geometry"/></mxCell><mxCell id="c107" value="&lt;b style=&quot;font-size:13px&quot;&gt;id-litware-app, id-litware-gw, budget&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=26;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1770" y="790" width="670" height="35" as="geometry"/></mxCell><mxCell id="c108" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/identity/Managed_Identities.svg;" vertex="1" parent="1"><mxGeometry x="2416" y="795" width="18" height="18" as="geometry"/></mxCell><mxCell id="c109" value="Adding a client = a new client RG + one entry" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1760" y="849" width="334" height="19" as="geometry"/></mxCell><mxCell id="c110" value="in the cell&#x27;s clients map. No vending, no new" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1760" y="867" width="334" height="19" as="geometry"/></mxCell><mxCell id="c111" value="gateway, no new environment." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=1;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1760" y="885" width="210" height="19" as="geometry"/></mxCell><mxCell id="c112" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#6b5ca5;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="345" y="212" as="sourcePoint"/><mxPoint x="395" y="531" as="targetPoint"/><Array as="points"><mxPoint x="370" y="212"/><mxPoint x="370" y="531"/></Array></mxGeometry></mxCell><mxCell id="c113" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#6b5ca5;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="655" y="513" as="sourcePoint"/><mxPoint x="770" y="310" as="targetPoint"/><Array as="points"><mxPoint x="684" y="513"/><mxPoint x="684" y="310"/></Array></mxGeometry></mxCell><mxCell id="c114" value="1" style="ellipse;html=1;fillColor=#6b5ca5;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="672" y="461" width="24" height="24" as="geometry"/></mxCell><mxCell id="c115" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#6b5ca5;strokeWidth=2.2;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="345" y="322" as="sourcePoint"/><mxPoint x="770" y="350" as="targetPoint"/><Array as="points"><mxPoint x="364" y="322"/><mxPoint x="364" y="161"/><mxPoint x="700" y="161"/><mxPoint x="700" y="350"/></Array></mxGeometry></mxCell><mxCell id="c116" value="5" style="ellipse;html=1;fillColor=#6b5ca5;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="688" y="189" width="24" height="24" as="geometry"/></mxCell><mxCell id="c117" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#6b5ca5;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="386" as="sourcePoint"/><mxPoint x="1040" y="481" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c118" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#b7791f;strokeWidth=2.6;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1193" y="481" as="sourcePoint"/><mxPoint x="1292" y="386" as="targetPoint"/><Array as="points"><mxPoint x="1193" y="446"/><mxPoint x="1292" y="446"/></Array></mxGeometry></mxCell><mxCell id="c119" value="2" style="ellipse;html=1;fillColor=#b7791f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1181" y="464" width="24" height="24" as="geometry"/></mxCell><mxCell id="c120" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#b7791f;strokeWidth=2.6;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1699" y="331" as="sourcePoint"/><mxPoint x="1770" y="251" as="targetPoint"/><Array as="points"><mxPoint x="1733" y="331"/><mxPoint x="1733" y="251"/></Array></mxGeometry></mxCell><mxCell id="c121" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f8a68;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="661" as="sourcePoint"/><mxPoint x="1040" y="723" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c122" value="3" style="ellipse;html=1;fillColor=#1f8a68;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1028" y="665" width="24" height="24" as="geometry"/></mxCell><mxCell id="c123" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f8a68;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1193" y="805" as="sourcePoint"/><mxPoint x="1770" y="347" as="targetPoint"/><Array as="points"><mxPoint x="1193" y="825"/><mxPoint x="1747" y="825"/><mxPoint x="1747" y="347"/></Array></mxGeometry></mxCell><mxCell id="c124" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#c0392b;strokeWidth=1.8;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="557" as="sourcePoint"/><mxPoint x="655" y="557" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c125" value="4" style="ellipse;html=1;fillColor=#c0392b;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="703" y="545" width="24" height="24" as="geometry"/></mxCell><mxCell id="c126" value="&lt;b style=&quot;font-size:14px&quot;&gt;How clients stay apart in a shared cell&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5b6675&quot;&gt;1. Data, keys and models are separate Azure resources per client, in the client&amp;#x27;s own resource group.&lt;br&gt;2. Each client has its own identities. Only id-&amp;lt;client&amp;gt;-app can use the client&amp;#x27;s storage, vault and index;&lt;br&gt;    only id-&amp;lt;client&amp;gt;-gw can call the client&amp;#x27;s Azure OpenAI. Keys are off everywhere, so a token is the only way in.&lt;br&gt;3. The gateway API for a client accepts only that client&amp;#x27;s app token and calls out only as that client&amp;#x27;s gateway identity.&lt;br&gt;4. Container apps accept traffic only from the App Gateway subnet, so one client&amp;#x27;s app can&amp;#x27;t call another&amp;#x27;s.&lt;br&gt;5. Per-client deployment identity: Contributor on its own resource group only. The cell identity has no data roles.&lt;br&gt;6. Terraform tests assert 1 to 5 for every client in the cell&amp;#x27;s clients map.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="30" y="1110" width="803" height="148" as="geometry"/></mxCell><mxCell id="c127" value="&lt;b style=&quot;font-size:14px&quot;&gt;What it costs (approx. list price, USD/month)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5b6675&quot;&gt;Shared per cell: App Gateway WAF_v2 ~400, APIM ~700 (Standard v2*), AI Search S1 x2 ~490,&lt;br&gt;Container Apps environment ~0 idle, cell Log Analytics ~50. About 1,650 per cell.&lt;br&gt;Per client: 3 private endpoints ~22, logs ~25, an always-on replica ~40, tokens as used.&lt;br&gt;About 90 per client + 1,650 / clients in the cell. At 20 clients: ~170 per client.&lt;br&gt;*Premium APIM (internal VNet mode, as built today) is ~2,800: ~280 per client at 20.&lt;br&gt;Tier 1 is ~700 to ~1,400 per client before tokens (~3,500 with a Premium gateway).&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="848" y="1110" width="803" height="148" as="geometry"/></mxCell><mxCell id="c128" value="&lt;b style=&quot;font-size:14px&quot;&gt;Fits / doesn&amp;#x27;t fit&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5b6675&quot;&gt;Fits: confidential client data where the contract accepts shared, Microsoft-managed&lt;br&gt;compute and edge, but wants dedicated data stores, keys, models and logs. Most hosted&lt;br&gt;solutions. Onboarding in hours, not days: no vending, no new gateway.&lt;br&gt;Doesn&amp;#x27;t fit: contracts that require a dedicated subscription, network-level separation,&lt;br&gt;their own ExpressRoute path with per-client firewall rules, or PTU capacity of their own.&lt;br&gt;Those clients stay on Tier 1. Moving up is a data copy plus a new stamp.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3cad4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=4;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1666" y="1110" width="803" height="148" as="geometry"/></mxCell><mxCell id="c129" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#f3f1f8;strokeColor=#6b5ca5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="1278" width="2440" height="184" as="geometry"/></mxCell><mxCell id="c130" value="Legend" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=17;fontStyle=1;fontColor=#6b5ca5;" vertex="1" parent="1"><mxGeometry x="44" y="1286" width="63" height="23" as="geometry"/></mxCell><mxCell id="c131" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#3b74c4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="1326" width="34" height="22" as="geometry"/></mxCell><mxCell id="c132" value="Owned by Platform Engineering (P&amp;T)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="94" y="1328" width="261" height="19" as="geometry"/></mxCell><mxCell id="c133" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f4f6;strokeColor=#1f7f8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="369" y="1326" width="34" height="22" as="geometry"/></mxCell><mxCell id="c134" value="Shared in the cell: carries client traffic, stores none" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="413" y="1328" width="406" height="19" as="geometry"/></mxCell><mxCell id="c135" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf3e6;strokeColor=#b7791f;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="828" y="1326" width="34" height="22" as="geometry"/></mxCell><mxCell id="c136" value="Per client: client data, keys, models, identities" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="872" y="1328" width="363" height="19" as="geometry"/></mxCell><mxCell id="c137" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3f1f8;strokeColor=#6b5ca5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1245" y="1326" width="34" height="22" as="geometry"/></mxCell><mxCell id="c138" value="Users" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1289" y="1328" width="42" height="19" as="geometry"/></mxCell><mxCell id="c139" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1354" y="1326" width="34" height="22" as="geometry"/></mxCell><mxCell id="c140" value="Key isolation control" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=13;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1398" y="1328" width="159" height="19" as="geometry"/></mxCell><mxCell id="c141" value="1" style="ellipse;html=1;fillColor=#6b5ca5;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="1359" width="24" height="24" as="geometry"/></mxCell><mxCell id="c142" value="User path: client network -&gt; hub firewall -&gt; shared App Gateway (listener per client) -&gt; client&#x27;s app" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="80" y="1363" width="685" height="18" as="geometry"/></mxCell><mxCell id="c143" value="2" style="ellipse;html=1;fillColor=#b7791f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1250" y="1359" width="24" height="24" as="geometry"/></mxCell><mxCell id="c144" value="Model path: client&#x27;s app -&gt; shared AI gateway (client&#x27;s API) -&gt; client&#x27;s own Azure OpenAI" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1280" y="1363" width="604" height="18" as="geometry"/></mxCell><mxCell id="c145" value="3" style="ellipse;html=1;fillColor=#1f8a68;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="1387" width="24" height="24" as="geometry"/></mxCell><mxCell id="c146" value="Data path: client&#x27;s app identity -&gt; its own storage, vault and search index (private endpoints)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="80" y="1391" width="644" height="18" as="geometry"/></mxCell><mxCell id="c147" value="4" style="ellipse;html=1;fillColor=#c0392b;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1250" y="1387" width="24" height="24" as="geometry"/></mxCell><mxCell id="c148" value="Egress: cell workload subnets -&gt; hub firewall (UDR)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1280" y="1391" width="349" height="18" as="geometry"/></mxCell><mxCell id="c149" value="5" style="ellipse;html=1;fillColor=#6b5ca5;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="1415" width="24" height="24" as="geometry"/></mxCell><mxCell id="c150" value="Private Link: client&#x27;s own Azure VNet -&gt; private endpoint -&gt; cell App Gateway Private Link" style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="80" y="1419" width="611" height="18" as="geometry"/></mxCell><mxCell id="c151" value="Sources: docs/adr/0014-isolation-tiers.md, docs/architecture/isolation-tiers.md, terraform/stamps/cell, terraform/stamps/cell-client. Names and addresses are the example configs." style="text;html=1;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontSize=12;fontStyle=0;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="50" y="1435" width="1202" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>