{
  "properties": {
    "displayName": "AI Advisory: Cognitive Services accounts must disable local (key) auth",
    "mode": "Indexed",
    "policyRule": {
      "if": {
        "allOf": [
          { "field": "type", "equals": "Microsoft.CognitiveServices/accounts" },
          { "field": "Microsoft.CognitiveServices/accounts/disableLocalAuth", "notEquals": true }
        ]
      },
      "then": { "effect": "[parameters('effect')]" }
    },
    "parameters": {
      "effect": { "type": "String", "allowedValues": ["Audit", "Deny", "Disabled"], "defaultValue": "Deny" }
    }
  }
}
